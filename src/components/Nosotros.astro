---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import isotipo from '../assets/marca/isotipo.png';

const noticias = (await getCollection('noticias'))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 4)
  .map((n) => ({
    ...n,
    // Enlace externo, o la página propia de la nota si tiene texto completo
    href: n.data.enlace ?? (n.body?.trim() ? `/noticias/${n.id}` : undefined),
  }));

// Foto grupal: basta con poner el archivo en src/assets/fotos/equipo.jpg (o .png / .webp)
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/equipo.{jpg,jpeg,png,webp}', { eager: true });
const fotoEquipo = Object.values(fotos)[0]?.default;
---

<section id="nosotros" class="seccion">
  <div class="contenedor nosotros">
    <div class="nosotros__principal">
      <div class="revelar">
        <p class="antetitulo">Quiénes somos</p>
        <h2 class="titulo-seccion">Que lo nuestro <em>siga sonando</em></h2>
      </div>

      <div class="nosotros__cuerpo">
        <figure class="foto revelar">
          {
            fotoEquipo ? (
              <Image
                src={fotoEquipo}
                alt="El equipo de Entre Jaranas"
                widths={[480, 720, 960, 1280, 1800, 2400]}
                quality={90}
                sizes="(max-width: 1080px) calc(100vw - 4rem), 900px"
                class="foto__img"
              />
            ) : (
              <div class="foto__vacia">
                <Image src={isotipo} alt="" width={180} />
                <span>Aquí irá la foto grupal del equipo</span>
              </div>
            )
          }
          <figcaption>El equipo de Entre Jaranas · San Marcos</figcaption>
        </figure>

        <div class="nosotros__texto revelar">
          <p class="destacado">
            Somos <strong>Entre Jaranas</strong>, una iniciativa que nació de sanmarquinos con ganas de hacer que lo nuestro
            siga sonando.
          </p>
          <p>
            Creamos experiencias presenciales y digitales para que más jóvenes se encuentren con la música criolla, conozcan
            sus historias, sus espacios y, sobre todo, a las personas que la viven y la mantienen presente.
          </p>
          <p>
            Porque no, la música criolla no está muerta. Sigue en quienes la cantan, la bailan, la tocan, la enseñan y se
            reúnen alrededor de ella.
          </p>
          <p>
            Nosotros solo queremos acercarte un poquito más a esa jarana. <a href="#contacto" class="sumate">¿Te sumas?</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Noticias: arriba la destacada, que va cambiando sola entre las cuatro más recientes
         (se pausa con el mouse encima); debajo, la lista con todas. Sin fechas, a propósito. -->
    <aside id="noticias" class="prensa revelar" aria-labelledby="noticias-titulo" data-rota>
      <h2 id="noticias-titulo" class="prensa__titulo">Noticias</h2>
      <div class="prensa__escena" aria-live="off">
        {
          noticias.map((n, i) => (
            <article class:list={['destacada', { activa: i === 0 }]}>
              {n.data.imagen && (
                <Image src={n.data.imagen} alt={n.data.imagenAlt ?? ''} width={640} quality={85} class="destacada__img" />
              )}
              <span class="destacada__tipo">{n.data.tipo}</span>
              <h3>{n.href ? <a href={n.href} {...(n.data.enlace && { target: '_blank', rel: 'noopener' })}>{n.data.titulo}</a> : n.data.titulo}</h3>
              <p>{n.data.resumen}</p>
              {n.href && (
                <a href={n.href} class="noticia__mas" tabindex="-1" {...(n.data.enlace && { target: '_blank', rel: 'noopener' })}>
                  Leer la nota
                </a>
              )}
            </article>
          ))
        }
      </div>
      <ol class="prensa__lista">
        {
          noticias.map((n, i) =>
            n.href ? (
              <li id={`noticia-${n.id}`}>
                <a href={n.href} class:list={['prensa__item', { activa: i === 0 }]} {...(n.data.enlace && { target: '_blank', rel: 'noopener' })}>
                  {n.data.titulo}
                  <i class="prensa__barra" />
                </a>
              </li>
            ) : (
              <li id={`noticia-${n.id}`}>
                <button type="button" class:list={['prensa__item', { activa: i === 0 }]}>
                  {n.data.titulo}
                  <i class="prensa__barra" />
                </button>
              </li>
            ),
          )
        }
      </ol>
    </aside>
  </div>
</section>

<style>
  .nosotros {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .nosotros__cuerpo {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: 2.5rem;
  }

  .foto {
    margin: 0;
    background: var(--blanco);
    padding: 0.9rem 0.9rem 0;
    border-radius: 6px;
    box-shadow: var(--sombra);
    transform: rotate(-1.5deg);
    transition: transform 0.4s ease;
  }
  .foto:hover {
    transform: rotate(0) scale(1.01);
  }
  .foto__img,
  .foto__vacia {
    width: 100%;
    border-radius: 3px;
  }
  .foto__img {
    height: auto;
  }
  .foto__vacia {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    text-align: center;
    padding: 1rem;
    border-radius: 3px;
    background: var(--vino);
    color: var(--crema);
    font-size: 0.9rem;
  }
  .foto__vacia img {
    width: 40%;
    height: auto;
  }
  .foto figcaption {
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: 0.9rem;
    text-align: center;
    padding: 0.8rem 0 1rem;
    color: var(--cafe);
  }

  .nosotros__texto {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.1rem clamp(1.5rem, 4vw, 3rem);
    align-content: start;
  }
  .nosotros__texto > * {
    grid-column: 2;
  }
  .nosotros__texto > .destacado {
    grid-column: 1;
    grid-row: 1 / span 3;
  }
  .sumate {
    font-weight: 700;
    color: var(--vino);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .sumate:hover {
    color: var(--teja);
  }
  .destacado {
    font-family: var(--f-titulo);
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--cafe);
  }

  .prensa {
    position: sticky;
    top: 6.5rem;
    background: var(--cafe);
    color: var(--crema);
    border-radius: var(--radio);
    padding: 1.75rem 1.5rem;
  }
  .prensa__titulo {
    color: var(--oro);
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }
  /* Destacada: todas apiladas en la misma celda; solo la activa se ve, así la caja no cambia de alto */
  .prensa__escena {
    display: grid;
  }
  .destacada {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s ease,
      visibility 0s linear 0.6s;
  }
  .destacada.activa {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease;
  }
  .destacada__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
    margin-bottom: 0.9rem;
    transform: scale(1.03);
    transition: transform 7s linear;
  }
  .destacada.activa .destacada__img {
    transform: scale(1);
  }
  .destacada__tipo {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--oro);
    color: var(--cafe);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
  .destacada h3 {
    color: var(--crema);
    font-size: 1.1rem;
    margin-block: 0.6rem 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .destacada .noticia__mas {
    margin-top: auto;
    padding-top: 0.6rem;
  }
  .destacada h3 a {
    text-decoration-color: var(--oro);
  }
  .destacada p {
    font-size: 0.88rem;
    opacity: 0.8;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .noticia__mas {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--oro);
    text-underline-offset: 3px;
  }

  /* Lista: la activa se ilumina y su línea dorada marca cuánto falta para la siguiente */
  .prensa__lista {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .prensa__lista li {
    border-top: 1px dashed rgb(240 231 216 / 0.25);
  }
  .prensa__item {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 100%;
    padding: 0.75rem 0;
    cursor: pointer;
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.3;
    color: var(--crema);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }
  .prensa__item:hover,
  .prensa__item.activa {
    opacity: 1;
  }
  .prensa__item:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .prensa__barra {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--oro);
  }
  .prensa__item.activa .prensa__barra {
    animation: prensa-avanza 7s linear forwards;
  }
  .prensa:hover .prensa__barra,
  .prensa:focus-within .prensa__barra {
    animation-play-state: paused;
  }
  @keyframes prensa-avanza {
    to {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .destacada,
    .destacada.activa,
    .destacada__img {
      transition: none;
    }
    .prensa__item.activa .prensa__barra {
      animation: none;
      width: 100%;
    }
  }

  @media (max-width: 1080px) {
    .nosotros {
      grid-template-columns: 1fr;
    }
    .prensa {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 0 2rem;
      align-items: start;
    }
    .prensa__titulo {
      grid-column: 1 / -1;
    }
    .prensa__lista {
      margin-top: 0;
    }
    .prensa__lista li:first-child {
      border-top: 0;
    }
  }
  @media (max-width: 640px) {
    .prensa {
      grid-template-columns: 1fr;
    }
    .prensa__lista {
      margin-top: 1rem;
    }
    .prensa__lista li:first-child {
      border-top: 1px dashed rgb(240 231 216 / 0.25);
    }
  }
  @media (max-width: 720px) {
    .nosotros__texto {
      grid-template-columns: 1fr;
    }
    .nosotros__texto > *,
    .nosotros__texto > .destacado {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>

<script>
  // Noticias que van cambiando: la destacada pasa a la siguiente cuando termina la línea dorada
  // de la lista (la animación se pausa con el mouse encima o con el foco del teclado).
  // Pasar el mouse por un título de la lista lo muestra arriba; hacer clic abre la nota.
  document.querySelectorAll<HTMLElement>('[data-rota]').forEach((caja) => {
    const destacadas = caja.querySelectorAll('.destacada');
    const items = caja.querySelectorAll<HTMLElement>('.prensa__item');
    if (destacadas.length < 2) return;
    let actual = 0;

    const mostrar = (i: number) => {
      actual = (i + destacadas.length) % destacadas.length;
      destacadas.forEach((d, k) => d.classList.toggle('activa', k === actual));
      items.forEach((it, k) => {
        it.classList.remove('activa');
        if (k === actual) {
          void it.offsetWidth; // reinicia la animación de la línea
          it.classList.add('activa');
        }
      });
    };

    items.forEach((it, k) => {
      it.addEventListener('mouseenter', () => k !== actual && mostrar(k));
      it.addEventListener('focus', () => k !== actual && mostrar(k));
      if (it.tagName === 'BUTTON') it.addEventListener('click', () => mostrar(k));
      it.querySelector('.prensa__barra')?.addEventListener('animationend', () => {
        if (k === actual) mostrar(actual + 1);
      });
    });
  });
</script>
