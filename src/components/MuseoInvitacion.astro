---
import { Image } from 'astro:assets';
import isotipo from '../assets/marca/isotipo.png';
import { sitio } from '../data/sitio';
import { generos } from '../data/museo';

// En el orden de los arcos de la casona, de izquierda a derecha
const salas = ['tondero', 'marinera', 'vals', 'polka', 'festejo'].map((id) => generos.find((g) => g.id === id)!.nombre);
---

<section id="museo" class="museo">
  <div class="contenedor museo__in">
    <div class="ventana revelar" aria-hidden="true">
      <div class="ventana__arco">
        <Image src={isotipo} alt="" width={300} class="ventana__iso" />
      </div>
      <div class="ventana__celosia"></div>
    </div>

    <div class="museo__texto revelar">
      <p class="antetitulo">Museo virtual</p>
      <h2 class="titulo-seccion">{sitio.museoVirtual.nombre}</h2>
      <p class="museo__desc">{sitio.museoVirtual.descripcion}</p>
      <ul class="salas">
        {salas.map((s) => <li>{s}</li>)}
      </ul>
      <a href="/museo-virtual" class="boton boton--oro">Entrar al museo →</a>
    </div>
  </div>
</section>

<style>
  .museo {
    background: var(--cafe);
    color: var(--crema);
    padding-block: clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }
  .museo__in {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .museo .antetitulo {
    color: var(--oro);
  }
  .museo h2 {
    color: var(--crema);
  }
  .museo__desc {
    margin-top: 1.25rem;
    max-width: 52ch;
    opacity: 0.9;
  }
  .salas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 2.25rem;
  }
  .salas li {
    border: 1.5px solid rgb(240 231 216 / 0.4);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-size: 0.9rem;
  }

  /* Ventana inspirada en los balcones limeños */
  .ventana {
    position: relative;
    max-width: 380px;
    width: 100%;
    margin-inline: auto;
  }
  .ventana__arco {
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 18px 18px;
    background: var(--vino);
    border: 10px solid var(--oro);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 0 10px var(--cafe), 0 0 0 12px rgb(254 173 21 / 0.5);
  }
  .ventana__arco::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/patron.png');
    background-size: 80px;
    filter: brightness(2.2) saturate(0.3);
    opacity: 0.18;
  }
  .ventana__iso {
    position: relative;
    width: 72%;
    height: auto;
    transition: transform 0.6s ease;
  }
  .ventana:hover .ventana__iso {
    transform: scale(1.06) rotate(-5deg);
  }
  .ventana__celosia {
    height: 46px;
    margin: 12px 6% 0;
    border-radius: 6px;
    background: repeating-linear-gradient(90deg, var(--oro) 0 6px, transparent 6px 18px);
    opacity: 0.85;
  }

  @media (max-width: 820px) {
    .museo__in {
      grid-template-columns: 1fr;
    }
    .ventana {
      max-width: 260px;
    }
  }
</style>
