---
// Arpa de madera, vista de costado; (x, y) es el punto de apoyo en el piso
interface Props {
  x: number;
  y: number;
  escala?: number;
}

const { x, y, escala = 1 } = Astro.props;

// Consola (cuello) como curva de Bézier: las cuerdas cuelgan de ella hasta la caja
const p0 = [74, -452];
const p1 = [20, -500];
const p2 = [-50, -380];
const p3 = [-128, -414];
const bez = (t: number) =>
  [0, 1].map((i) => (1 - t) ** 3 * p0[i] + 3 * (1 - t) ** 2 * t * p1[i] + 3 * (1 - t) * t ** 2 * p2[i] + t ** 3 * p3[i]);
const muestras = Array.from({ length: 80 }, (_, i) => bez(i / 79));
const yCuello = (cx: number) => muestras.reduce((a, b) => (Math.abs(b[0] - cx) < Math.abs(a[0] - cx) ? b : a))[1] + 10;
// Cara frontal de la caja: de (60, -30) a (-112, -392)
const yCaja = (cx: number) => -30 + ((60 - cx) * (392 - 30)) / 172;
const cuerdas = Array.from({ length: 26 }, (_, i) => {
  const cx = 50 - i * 6;
  return { cx, y1: yCuello(cx), y2: yCaja(cx), roja: i % 7 === 3 };
});
---

<g transform={`translate(${x} ${y}) scale(${escala})`}>
  <ellipse cx="0" cy="4" rx="130" ry="14" fill="#1c0b03" opacity="0.35" />
  <!-- Caja de resonancia -->
  <polygon points="60,-30 -112,-392 -138,-380 -18,0 50,0" fill="url(#g-madera-h)" stroke="#3a1d08" stroke-width="3" />
  <polygon points="60,-30 -112,-392 -100,-394 64,-44" fill="#c78a4e" opacity="0.55" />
  {[0.25, 0.45, 0.65].map((t) => <ellipse cx={60 - 172 * t - 18} cy={-30 - 362 * t + 10} rx="9" ry="6" fill="#2a1406" />)}
  <!-- Cuerdas -->
  {
    cuerdas.map((c) => (
      <line x1={c.cx} y1={c.y1} x2={c.cx} y2={c.y2} stroke={c.roja ? '#c0303a' : '#f6ecd2'} stroke-width={c.roja ? 1.8 : 1.3} opacity="0.9" />
    ))
  }
  <!-- Columna -->
  <rect x="62" y="-452" width="20" height="440" rx="6" fill="url(#g-madera-h)" stroke="#3a1d08" stroke-width="2" />
  {[-420, -300, -150, -40].map((yy) => <rect x="58" y={yy} width="28" height="10" rx="4" fill="url(#g-oro)" />)}
  <!-- Consola -->
  <path d={`M${p0} C${p1} ${p2} ${p3}`} fill="none" stroke="#3a1d08" stroke-width="26" stroke-linecap="round" />
  <path d={`M${p0} C${p1} ${p2} ${p3}`} fill="none" stroke="url(#g-madera)" stroke-width="20" stroke-linecap="round" />
  <path d="M-128 -414 c-24 -6 -30 -34 -8 -40 c16 -4 22 14 8 18" fill="none" stroke="url(#g-madera)" stroke-width="12" stroke-linecap="round" />
  {muestras.filter((_, i) => i % 3 === 1 && i < 75).map(([mx, my]) => <circle cx={mx} cy={my + 4} r="2.4" fill="#e9c46a" />)}
</g>
