---
// Sala del tondero: casa norteña encalada y luminosa, con techo de caña y una gran ventana
// abierta al campo de Piura, con algarrobos. Escena ancha (2400 × 900).
import { generos } from '../../../data/museo-prototipo';
import Interactivo from './Interactivo.astro';

const sala = generos.find((x) => x.id === 'tondero')!;
const o = (id: string) => sala.objetos.find((x) => x.id === id)!;

const W = 2400;
const piso = 740;
const f = (n: number) => n.toFixed(1);

// Baldosas pasteleras del piso, en perspectiva hacia el centro
const fuga = { x: 1200, y: 380 };
const juntas = Array.from({ length: 49 }, (_, i) => {
  const x = i * 50;
  const xb = fuga.x + (x - fuga.x) * ((900 - fuga.y) / (piso - fuga.y));
  return `M${x} ${piso} L${f(xb)} 900`;
});
const hiladas = [756, 776, 802, 834, 874].map((y) => `M0 ${y} H${W}`);

// Copa de algarrobo: racimos de hojas achatados, generados de forma fija
function copa(cx: number, cy: number, ancho: number, alto: number, semilla: number) {
  const tonos = ['#4f6d25', '#6b8c35', '#86a645', '#5d7d2c'];
  return Array.from({ length: 26 }, (_, i) => {
    const a = (i * 137.5 + semilla * 31) % 360;
    const r = ((i * 53 + semilla * 17) % 100) / 100;
    const x = cx + Math.cos((a * Math.PI) / 180) * ancho * 0.42 * r;
    const y = cy + Math.sin((a * Math.PI) / 180) * alto * 0.32 * r - (i % 3) * 3;
    return { x, y, rx: ancho * (0.16 + (i % 4) * 0.025), ry: alto * (0.2 + (i % 3) * 0.04), c: tonos[i % 4] };
  });
}
const algarrobos = [
  { x: 1060, y: 520, s: 0.75, semilla: 1 },
  { x: 1330, y: 500, s: 1, semilla: 2 },
  { x: 1190, y: 486, s: 0.45, semilla: 3 },
];

// Vasija de Chulucanas: negra y naranja, con dibujos geométricos
const vasijas = [
  { x: 2270, s: 1.15 },
];

// Mapa de Piura estilizado (coordenadas dentro del mapa, 0–300 × 0–260)
const contorno =
  'M70 22 L120 14 L170 26 L214 18 L250 40 L262 82 L240 112 L254 150 L236 196 L196 222 L150 240 L104 236 L86 210 L60 196 L40 170 L52 148 L34 126 L46 106 L28 82 L40 56Z';
// dx, dy: posición del nombre respecto del punto
const pueblos = [
  { n: 'Talara', x: 40, y: 58, dx: 7, dy: -6, a: 'start' },
  { n: 'Sullana', x: 116, y: 86, dx: 0, dy: -9, a: 'middle' },
  { n: 'Paita', x: 38, y: 126, dx: 8, dy: 4, a: 'start' },
  { n: 'Piura', x: 128, y: 148, dx: 0, dy: -11, a: 'middle', grande: true },
  { n: 'Catacaos', x: 112, y: 176, dx: -7, dy: 4, a: 'end' },
  { n: 'Chulucanas', x: 186, y: 140, dx: 0, dy: -9, a: 'middle' },
  { n: 'Sechura', x: 74, y: 208, dx: 8, dy: 4, a: 'start' },
  { n: 'Ayabaca', x: 216, y: 62, dx: 0, dy: -9, a: 'middle' },
  { n: 'Huancabamba', x: 214, y: 188, dx: -7, dy: 4, a: 'end' },
];
---

<div class="vista-2d" data-vista="sala-tondero" data-ancho="2400">
  <svg viewBox={`0 0 ${W} 900`} width={W} height="900" class="lamina">
    <defs>
      <linearGradient id="td-pared" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fbf5e6" />
        <stop offset="0.6" stop-color="#f1e6cc" />
        <stop offset="1" stop-color="#e2d2ad" />
      </linearGradient>
      <linearGradient id="td-cielo" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#5fb0e0" />
        <stop offset="0.55" stop-color="#b9e2f4" />
        <stop offset="1" stop-color="#fff2cf" />
      </linearGradient>
      <linearGradient id="td-arena" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ecd29a" />
        <stop offset="1" stop-color="#d4a865" />
      </linearGradient>
      <linearGradient id="td-cerros" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9fb2bf" />
        <stop offset="1" stop-color="#c9d3d2" />
      </linearGradient>
      <linearGradient id="td-teja" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c9764a" />
        <stop offset="1" stop-color="#a65a33" />
      </linearGradient>
      <linearGradient id="td-calabaza" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f2cf86" />
        <stop offset="0.45" stop-color="#d49a45" />
        <stop offset="1" stop-color="#8a5418" />
      </linearGradient>
      <linearGradient id="td-paja" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#b48a42" />
        <stop offset="0.5" stop-color="#e8c47a" />
        <stop offset="1" stop-color="#a77c36" />
      </linearGradient>
      <linearGradient id="td-pergamino" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f6e8c3" />
        <stop offset="0.6" stop-color="#ead39d" />
        <stop offset="1" stop-color="#d5b47a" />
      </linearGradient>
      <radialGradient id="td-sol" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fffbe8" />
        <stop offset="0.25" stop-color="#fff0b0" stop-opacity="0.9" />
        <stop offset="1" stop-color="#fff0b0" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="td-vasija" cx="0.35" cy="0.35" r="0.75">
        <stop offset="0" stop-color="#4a3a32" />
        <stop offset="1" stop-color="#140c08" />
      </radialGradient>
      <pattern id="td-cana" width="40" height="12" patternUnits="userSpaceOnUse">
        <rect width="40" height="12" fill="#d8b876" />
        <rect y="1" width="40" height="5" rx="2.5" fill="#ecd39a" />
        <rect y="7" width="40" height="4" rx="2" fill="#c9a660" />
        <path d="M12 1v5M31 7v4" stroke="#a7843f" stroke-width="1.5" />
      </pattern>
      <pattern id="td-tejido" width="16" height="16" patternUnits="userSpaceOnUse">
        <rect width="16" height="16" fill="#c99a52" />
        <path d="M0 4h8v8H0zM8 0h8v4H8zM8 12h8v4H8z" fill="#a57a36" />
        <path d="M0 0h16v16H0z" fill="none" stroke="#7d5a24" stroke-width="1" />
      </pattern>
      <pattern id="td-panuelo" width="26" height="26" patternUnits="userSpaceOnUse">
        <rect width="26" height="26" fill="#d0312d" />
        <circle cx="6" cy="6" r="3" fill="#f6c43e" />
        <circle cx="19" cy="19" r="3" fill="#fbf3e0" />
        <path d="M19 3l2 3h-4zM6 16l2 3h-4z" fill="#2f7a4a" />
      </pattern>
      <clipPath id="td-clip-ventana"><rect x="960" y="170" width="480" height="430" /></clipPath>
      <clipPath id="td-clip-ventanita"><rect x="96" y="226" width="190" height="300" /></clipPath>
    </defs>

    <!-- Pared encalada -->
    <rect width={W} height={piso} fill="url(#td-pared)" />
    <ellipse cx="1200" cy="420" rx="900" ry="380" fill="#fff8e2" opacity="0.6" />
    <path d="M300 300 c40 -20 90 10 140 -6 M1700 220 c60 18 110 -10 170 8 M2050 560 c40 -12 70 6 110 -4" stroke="#d9c79f" stroke-width="3" fill="none" opacity="0.6" />

    <!-- Techo de caña con rollizos -->
    <rect width={W} height="100" fill="url(#td-cana)" />
    <rect y="80" width={W} height="20" fill="#8a6230" opacity="0.35" />
    <rect y="90" width={W} height="28" fill="url(#g-madera)" />
    <rect y="90" width={W} height="6" fill="#d9a46a" opacity="0.5" />
    {
      Array.from({ length: 13 }, (_, i) => 80 + i * 190).map((x) => (
        <g>
          <circle cx={x} cy="104" r="20" fill="#b07a42" stroke="#5e3417" stroke-width="3" />
          <circle cx={x} cy="104" r="12" fill="none" stroke="#7d4f24" stroke-width="2" />
          <circle cx={x} cy="104" r="4" fill="#7d4f24" />
        </g>
      ))
    }
    <rect y="96" width={W} height="60" fill="url(#g-piso-sombra)" opacity="0.5" />

    <!-- Zócalo verde -->
    <rect y="640" width={W} height={piso - 640} fill={sala.color} />
    <rect y="632" width={W} height="10" fill="#e3d29a" />
    <rect y="640" width={W} height={piso - 640} fill="url(#g-zocalo)" />

    <!-- Ventanita con barrotes torneados (izquierda) -->
    <g>
      <g clip-path="url(#td-clip-ventanita)">
        <rect x="96" y="226" width="190" height="300" fill="url(#td-cielo)" />
        <path d="M96 470 C150 450 210 466 286 452 V526 H96Z" fill="url(#td-arena)" />
        <path d="M200 470 c-4 -30 6 -50 -2 -78 M200 430 c14 -10 24 -26 30 -40" stroke="#5a3a1c" stroke-width="7" fill="none" stroke-linecap="round" />
        {copa(212, 386, 150, 70, 5).map((h) => <ellipse cx={h.x} cy={h.y} rx={h.rx} ry={h.ry} fill={h.c} />)}
      </g>
      <rect x="80" y="210" width="222" height="332" fill="none" stroke="url(#g-madera)" stroke-width="18" />
      {[124, 162, 200, 238, 268].map((x) => (
        <g>
          <rect x={x - 5} y="226" width="10" height="300" fill="url(#g-madera-h)" />
          {[270, 330, 390, 450].map((y) => <ellipse cx={x} cy={y} rx="9" ry="6" fill="#8a5a2c" />)}
        </g>
      ))}
      <rect x="70" y="534" width="242" height="16" rx="3" fill="url(#g-madera)" />
    </g>

    <!-- Gran ventana abierta al campo de Piura -->
    <g>
      <g clip-path="url(#td-clip-ventana)">
        <rect x="960" y="170" width="480" height="430" fill="url(#td-cielo)" />
        <circle cx="1350" cy="250" r="110" fill="url(#td-sol)" />
        <circle cx="1350" cy="250" r="26" fill="#fffbe8" />
        <path d="M990 236 q20 -14 40 0 q16 -10 30 2 M1120 210 q14 -10 28 0 q12 -8 24 2" stroke="#fff" stroke-width="8" fill="none" stroke-linecap="round" opacity="0.8" />
        <path d="M960 470 L1010 430 L1070 452 L1140 410 L1210 446 L1290 420 L1360 452 L1440 428 V520 H960Z" fill="url(#td-cerros)" />
        <path d="M960 500 C1040 470 1140 492 1220 478 C1300 466 1380 486 1440 474 V600 H960Z" fill="url(#td-arena)" />
        <path d="M960 540 C1060 520 1160 552 1260 536 C1340 524 1400 540 1440 532 V600 H960Z" fill="#c99a58" opacity="0.6" />
        <!-- Casita de adobe con techo de caña -->
        <rect x="1210" y="468" width="56" height="30" fill="#d9b483" />
        <polygon points="1202,470 1274,470 1260,456 1216,456" fill="#a77c36" />
        <rect x="1232" y="480" width="12" height="18" fill="#6a4320" />
        <!-- Algarrobos -->
        {
          algarrobos.map((a) => (
            <g transform={`translate(${a.x} ${a.y}) scale(${a.s})`}>
              <ellipse cx="0" cy="62" rx="90" ry="10" fill="#a87a3e" opacity="0.5" />
              <path d="M-6 60 C-10 30 6 10 -4 -14 C-12 -30 -30 -40 -52 -48 M-4 -14 C10 -30 30 -36 56 -50 M2 10 C14 0 26 -10 40 -14" fill="none" stroke="#4e3218" stroke-width="12" stroke-linecap="round" />
              <path d="M-6 60 C-10 30 6 10 -4 -14" fill="none" stroke="#6e4a26" stroke-width="5" stroke-linecap="round" />
              {copa(0, -56, 200, 90, a.semilla).map((h) => (
                <ellipse cx={h.x} cy={h.y} rx={h.rx} ry={h.ry} fill={h.c} />
              ))}
            </g>
          ))
        }
        <path d="M1180 600 C1196 560 1220 540 1236 500" stroke="#e8cf9c" stroke-width="16" fill="none" opacity="0.7" />
      </g>
      <!-- Marco y postigos abiertos -->
      <rect x="946" y="156" width="508" height="458" fill="none" stroke="url(#g-madera)" stroke-width="28" />
      <path d="M1200 170 v430" stroke="#5e3417" stroke-width="0" />
      <polygon points="932,152 860,180 860,600 932,620" fill="url(#g-madera)" stroke="#3a1d08" stroke-width="3" />
      <polygon points="1468,152 1540,180 1540,600 1468,620" fill="url(#g-madera)" stroke="#3a1d08" stroke-width="3" />
      {[0, 1, 2].map((i) => (
        <g>
          <polygon points={`876,${206 + i * 132} 918,${196 + i * 132} 918,${304 + i * 132} 876,${306 + i * 132}`} fill="none" stroke="#c78a4e" stroke-width="3" opacity="0.7" />
          <polygon points={`1524,${206 + i * 132} 1482,${196 + i * 132} 1482,${304 + i * 132} 1524,${306 + i * 132}`} fill="none" stroke="#c78a4e" stroke-width="3" opacity="0.7" />
        </g>
      ))}
      <rect x="926" y="604" width="548" height="24" rx="4" fill="url(#g-madera)" />
    </g>

    <!-- Piso de baldosas pasteleras -->
    <rect y={piso} width={W} height={900 - piso} fill="url(#td-teja)" />
    <path d={juntas.join(' ') + ' ' + hiladas.join(' ')} stroke="#7a3f1e" stroke-width="2.5" opacity="0.65" />
    <rect y={piso} width={W} height="30" fill="#3a1606" opacity="0.18" />
    <!-- Luz de la ventana sobre el piso -->
    <polygon points="960,628 1440,628 1700,900 700,900" fill="#fff4d0" opacity="0.28" />
    <!-- Estera de junco -->
    <polygon points="1440,770 1780,770 1830,860 1390,860" fill="url(#td-tejido)" opacity="0.9" />
    <polygon points="1440,770 1780,770 1830,860 1390,860" fill="none" stroke="#7d5a24" stroke-width="3" />

    <!-- Vasijas de Chulucanas (adorno) -->
    {
      vasijas.map((v) => (
        <g transform={`translate(${v.x} 770) scale(${v.s})`}>
          <ellipse cx="0" cy="0" rx="74" ry="12" fill="#3a1606" opacity="0.35" />
          <path d="M-26 -196 h52 l-4 22 C40 -160 76 -120 74 -76 C72 -30 40 -4 0 -2 C-40 -4 -72 -30 -74 -76 C-76 -120 -40 -160 -22 -174Z" fill="url(#td-vasija)" />
          <path d="M-70 -96 C-40 -84 40 -84 70 -96 L72 -70 C40 -58 -40 -58 -72 -70Z" fill="#c9622e" />
          <path d="M-62 -92 l14 22 l14 -22 l14 22 l14 -22 l14 22 l14 -22 l14 22 l14 -22" fill="none" stroke="#f2d3a0" stroke-width="3" />
          <path d="M-50 -136 C-20 -150 20 -150 50 -136" fill="none" stroke="#c9622e" stroke-width="5" />
          <circle cx="0" cy="-36" r="10" fill="none" stroke="#c9622e" stroke-width="3" />
          <path d="M-30 -150 C-46 -120 -56 -60 -40 -24" stroke="#fff" stroke-width="5" fill="none" opacity="0.18" stroke-linecap="round" />
        </g>
      ))
    }

    <!-- 1. Sombrero de paja (en el traje del bailarín) -->
    <Interactivo id="sombrero" nombre={o('sombrero').nombre} cx={430} cy={490} alto={520} iy={330}>
      <g>
        <ellipse cx="430" cy="760" rx="170" ry="18" fill="#3a1606" opacity="0.35" />
        <path d="M280 744 h300 v-18 c0 -12 -300 -12 -300 0z" fill="url(#g-madera)" />
        <ellipse cx="430" cy="726" rx="150" ry="12" fill="#b07a42" />
        <image href="/prototipos/2d/tondero-varon.webp" x="258" y="244" width="350" height="480" />
      </g>
    </Interactivo>

    <!-- 2. Checo -->
    <Interactivo id="checo" nombre={o('checo').nombre} cx={830} cy={600} alto={300} iy={560}>
      <g transform="translate(830 772)">
        <ellipse cx="0" cy="0" rx="120" ry="14" fill="#3a1606" opacity="0.35" />
        <!-- Banquito -->
        <path d="M-80 -8 L-64 -96 M80 -8 L64 -96 M0 -4 L0 -96" stroke="url(#g-madera-osc)" stroke-width="12" stroke-linecap="round" />
        <ellipse cx="0" cy="-100" rx="96" ry="18" fill="url(#g-madera)" stroke="#3a1d08" stroke-width="3" />
        <!-- Rodete tejido -->
        <ellipse cx="0" cy="-112" rx="56" ry="12" fill="url(#td-tejido)" stroke="#7d5a24" stroke-width="2" />
        <!-- Calabaza -->
        <ellipse cx="0" cy="-196" rx="96" ry="90" fill="url(#td-calabaza)" />
        <path d="M-90 -214 C-40 -230 40 -230 90 -214" fill="none" stroke="#5a2e0e" stroke-width="3" />
        <path d="M-94 -184 C-40 -168 40 -168 94 -184" fill="none" stroke="#5a2e0e" stroke-width="3" />
        <path d="M-86 -206 l12 -10 l12 10 l12 -10 l12 10 l12 -10 l12 10 l12 -10 l12 10 l12 -10 l12 10 l12 -10 l12 10 l12 -10 l12 10" fill="none" stroke="#5a2e0e" stroke-width="2.5" />
        <path d="M-50 -150 c10 -16 26 -16 36 0 c-12 -6 -24 -6 -36 0z M20 -142 c10 -14 24 -14 32 0 c-10 -6 -22 -6 -32 0z" fill="#5a2e0e" />
        <ellipse cx="30" cy="-250" rx="30" ry="16" fill="#2a1406" stroke="#6a3a12" stroke-width="3" />
        <ellipse cx="-40" cy="-236" rx="26" ry="34" fill="#fff6dc" opacity="0.25" />
      </g>
    </Interactivo>

    <!-- 4. Canasta de cosecha -->
    <Interactivo id="canasta" nombre={o('canasta').nombre} cx={1200} cy={680} alto={240} iy={690}>
      <g transform="translate(1200 790)">
        <ellipse cx="0" cy="6" rx="170" ry="16" fill="#3a1606" opacity="0.35" />
        <!-- Frutas -->
        {[
          [-90, -96, 34, '#e9a02c'],
          [-40, -112, 36, '#f2b632'],
          [10, -104, 34, '#d9562a'],
          [60, -114, 36, '#f0a530'],
          [104, -94, 30, '#e57a2a'],
          [-64, -76, 24, '#7cab3a'],
          [-14, -80, 22, '#8fbf44'],
          [36, -78, 22, '#6f9e32'],
          [84, -74, 22, '#88b83f'],
        ].map(([x, y, r, c]) => (
          <g>
            <ellipse cx={x} cy={y} rx={r} ry={(r as number) * 0.86} fill={c as string} />
            <ellipse cx={(x as number) - (r as number) * 0.3} cy={(y as number) - (r as number) * 0.3} rx={(r as number) * 0.3} ry={(r as number) * 0.2} fill="#fff" opacity="0.35" />
          </g>
        ))}
        <path d="M-36 -146 c6 -14 18 -18 30 -14 M64 -150 c8 -12 20 -14 30 -8" stroke="#3f6a22" stroke-width="5" fill="none" stroke-linecap="round" />
        <!-- Cuerpo tejido -->
        <path d="M-150 -86 L150 -86 L124 -4 L-124 -4Z" fill="url(#td-tejido)" stroke="#6e4c1c" stroke-width="3" />
        <path d="M-150 -86 L150 -86" stroke="#7d5a24" stroke-width="14" stroke-linecap="round" />
        <path d="M-150 -86 L150 -86" stroke="#d9b06a" stroke-width="5" stroke-dasharray="10 6" stroke-linecap="round" />
        <path d="M-138 -46 h276" stroke={sala.color} stroke-width="8" opacity="0.9" />
        <path d="M-150 -86 C-150 -220 150 -220 150 -86" fill="none" stroke="#8a6230" stroke-width="12" />
        <path d="M-150 -86 C-150 -220 150 -220 150 -86" fill="none" stroke="#d9b06a" stroke-width="4" stroke-dasharray="12 8" />
      </g>
    </Interactivo>

    <!-- 3. Pañuelo de color sobre una silla -->
    <Interactivo id="panuelo-color" nombre={o('panuelo-color').nombre} cx={1610} cy={560} alto={420} iy={520}>
      <g transform="translate(1610 800)">
        <ellipse cx="0" cy="-2" rx="150" ry="14" fill="#3a1606" opacity="0.35" />
        <!-- Patas traseras y respaldo -->
        <path d="M-84 -50 V-420 M84 -50 V-420" stroke="url(#g-madera-osc)" stroke-width="20" stroke-linecap="round" />
        <circle cx="-84" cy="-432" r="16" fill="url(#g-madera)" />
        <circle cx="84" cy="-432" r="16" fill="url(#g-madera)" />
        <rect x="-76" y="-396" width="152" height="120" rx="6" fill="#7a3e1a" stroke="#3a1d08" stroke-width="3" />
        <rect x="-64" y="-384" width="128" height="96" rx="4" fill="none" stroke="#d9a640" stroke-width="2" stroke-dasharray="2 6" />
        <!-- Pañuelo colgado del respaldo -->
        <path d="M-96 -400 C-40 -414 40 -414 96 -400 C90 -340 60 -270 10 -214 C-30 -260 -80 -330 -96 -400Z" fill="url(#td-panuelo)" />
        <path d="M-96 -400 C-80 -330 -30 -260 10 -214 C60 -270 90 -340 96 -400" fill="none" stroke="#f6c43e" stroke-width="8" />
        <path d="M-40 -404 C-30 -350 -10 -290 4 -240 M40 -404 C34 -350 22 -290 8 -240" fill="none" stroke="#8e1c18" stroke-width="3" opacity="0.5" />
        <path d="M10 -214 l-6 22 M10 -214 l6 22 M10 -214 v24" stroke="#f6c43e" stroke-width="3" stroke-linecap="round" />
        <path d="M-96 -404 C-40 -418 40 -418 96 -404" fill="none" stroke="#a52520" stroke-width="10" stroke-linecap="round" />
        <!-- Asiento y patas delanteras -->
        <path d="M-110 -196 L110 -196 L124 -160 L-124 -160Z" fill="#8a4a22" stroke="#3a1d08" stroke-width="3" />
        <rect x="-124" y="-162" width="248" height="22" fill="url(#g-madera)" />
        <path d="M-112 -140 V-6 M112 -140 V-6" stroke="url(#g-madera)" stroke-width="18" stroke-linecap="round" />
        <path d="M-112 -60 H112" stroke="url(#g-madera-osc)" stroke-width="10" />
        <path d="M-84 -276 V-196 M84 -276 V-196" stroke="url(#g-madera-osc)" stroke-width="18" />
      </g>
    </Interactivo>

    <!-- 5. Mapa de Piura -->
    <Interactivo id="mapa" nombre={o('mapa').nombre} cx={1980} cy={370} alto={380}>
      <g transform="translate(1810 200)">
        <rect x="-18" y="-18" width="376" height="356" rx="4" fill="url(#g-madera)" stroke="#3a1d08" stroke-width="3" filter="url(#f-sombra)" />
        <rect x="0" y="0" width="340" height="320" fill="url(#td-pergamino)" />
        <rect x="8" y="8" width="324" height="304" fill="none" stroke="#8a6230" stroke-width="2" />
        <!-- Mar -->
        <path d="M8 8 H64 C40 60 30 120 30 160 C30 220 50 270 76 312 H8Z" fill="#a9c7c4" opacity="0.7" />
        {[60, 110, 160, 210, 260].map((y) => <path d={`M14 ${y} q8 -6 16 0 q8 6 16 0`} stroke="#5e8f8c" stroke-width="2" fill="none" />)}
        <text x="22" y="292" font-family="'Libre Baskerville', Georgia, serif" font-size="11" font-style="italic" fill="#3f6b69">Océano</text>
        <text x="22" y="304" font-family="'Libre Baskerville', Georgia, serif" font-size="11" font-style="italic" fill="#3f6b69">Pacífico</text>
        <g transform="translate(20 46)">
          <path d={contorno} fill="#dfe6b5" stroke="#6b4a1c" stroke-width="3" stroke-linejoin="round" />
          <path d={contorno} fill="none" stroke={sala.color} stroke-width="8" opacity="0.25" />
          <!-- Ríos Chira y Piura -->
          <path d="M236 88 C200 92 170 82 140 88 C110 92 80 96 46 104" fill="none" stroke="#3f7fa8" stroke-width="3" />
          <path d="M226 170 C200 160 180 146 150 150 C128 152 120 170 104 190 C92 204 84 210 76 214" fill="none" stroke="#3f7fa8" stroke-width="3" />
          <!-- Cerros de la sierra -->
          {[[226, 120], [240, 138], [210, 104]].map(([x, y]) => <path d={`M${x - 12} ${y} l12 -16 l12 16z`} fill="#8a6a3a" />)}
          {
            pueblos.map((p) => (
              <g>
                <circle cx={p.x} cy={p.y} r={p.grande ? 6 : 3.5} fill={p.grande ? '#a32a31' : '#3a1d08'} />
                <text
                  x={p.x + p.dx}
                  y={p.y + p.dy}
                  text-anchor={p.a}
                  font-family="Archivo, system-ui, sans-serif"
                  font-size={p.grande ? 14 : 10}
                  font-weight={p.grande ? 700 : 500}
                  fill="#3a1d08"
                >
                  {p.n}
                </text>
              </g>
            ))
          }
        </g>
        <!-- Cartela y rosa de los vientos -->
        <rect x="180" y="16" width="146" height="34" rx="4" fill="#fbf3e0" stroke="#8a6230" stroke-width="2" />
        <text x="253" y="40" text-anchor="middle" font-family="'Libre Baskerville', Georgia, serif" font-weight="700" font-size="18" letter-spacing="4" fill="#5e3417">PIURA</text>
        <g transform="translate(296 262)">
          <path d="M0 -26 L6 0 L0 26 L-6 0Z M-26 0 L0 -6 L26 0 L0 6Z" fill="#5e3417" />
          <circle r="5" fill="#d9a640" />
          <text y="-30" text-anchor="middle" font-family="Archivo, system-ui, sans-serif" font-size="10" font-weight="700" fill="#5e3417">N</text>
        </g>
      </g>
    </Interactivo>

    <rect width={W} height="900" fill="url(#g-vineta)" opacity="0.6" pointer-events="none" />
  </svg>
</div>
