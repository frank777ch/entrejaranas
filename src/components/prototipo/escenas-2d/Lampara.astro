---
// Lámpara colgante de bronce con velas, vista de frente; (x, y) es el centro del cuerpo
interface Props {
  x: number;
  y: number;
  escala?: number;
  cadena?: number;
}

const { x, y, escala = 1, cadena = 200 } = Astro.props;
const brazos = [-150, -90, -30, 30, 90, 150];
---

<g transform={`translate(${x} ${y}) scale(${escala})`}>
  <circle cx="0" cy="-10" r="220" fill="url(#g-halo)" opacity="0.75" />
  <line x1="0" y1={-cadena} x2="0" y2="-40" stroke="#5a3a10" stroke-width="5" stroke-dasharray="10 5" />
  <ellipse cx="0" cy="-40" rx="22" ry="10" fill="url(#g-oro)" />
  <path d="M-10 -36 h20 l6 40 h-32z" fill="url(#g-oro)" />
  <ellipse cx="0" cy="14" rx="30" ry="22" fill="url(#g-oro)" stroke="#7a5212" stroke-width="2" />
  {
    brazos.map((bx) => (
      <g>
        <path d={`M0 18 C${bx * 0.3} 50 ${bx * 0.85} 50 ${bx} 4`} fill="none" stroke="url(#g-oro)" stroke-width="6" stroke-linecap="round" />
        <ellipse cx={bx} cy="2" rx="16" ry="6" fill="url(#g-oro)" />
        <rect x={bx - 5} y="-28" width="10" height="28" rx="2" fill="#fbf3e0" />
        <path d={`M${bx} -30 c-6 -8 -2 -16 0 -22 c2 6 6 14 0 22z`} fill="#ffcf5a" />
      </g>
    ))
  }
  <path d="M-8 34 h16 l-8 26z" fill="url(#g-oro)" />
  <circle cx="0" cy="64" r="7" fill="url(#g-oro)" />
</g>
