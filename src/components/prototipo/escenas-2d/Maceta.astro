---
// Maceta de barro con planta; (x, y) es el centro de la base
interface Props {
  x: number;
  y: number;
  escala?: number;
}

const { x, y, escala = 1 } = Astro.props;
const hojas = [-62, -40, -20, -4, 12, 30, 50, 68, -75, 80];
---

<g transform={`translate(${x} ${y}) scale(${escala})`}>
  <ellipse cx="0" cy="2" rx="62" ry="10" fill="#1c0b03" opacity="0.35" />
  <g>
    {
      hojas.map((a, i) => (
        <path
          d="M0 0 C-14 -50 -10 -110 0 -150 C10 -110 14 -50 0 0Z"
          transform={`translate(0 -96) rotate(${a}) scale(${0.75 + (i % 3) * 0.12})`}
          fill="url(#g-hoja)"
          stroke="#26421b"
          stroke-width="2"
        />
      ))
    }
  </g>
  <path d="M-46 -98 h92 l-12 98 h-68 z" fill="url(#g-ceramica)" />
  <rect x="-54" y="-112" width="108" height="18" rx="4" fill="#b8582c" />
  <rect x="-54" y="-112" width="108" height="5" rx="2" fill="#e08a58" opacity="0.6" />
  <path d="M-42 -66 h84" stroke="#f1d9a8" stroke-width="5" stroke-dasharray="10 8" opacity="0.75" />
</g>
