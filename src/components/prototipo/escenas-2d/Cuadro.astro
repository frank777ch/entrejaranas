---
// Cuadro con marco dorado. Con `imagen` muestra una foto; si no, lo que venga en el slot.
interface Props {
  x: number;
  y: number;
  ancho: number;
  alto: number;
  imagen?: string;
  marco?: number;
}

const { x, y, ancho, alto, imagen, marco = 18 } = Astro.props;
const id = `lienzo-${Math.round(x)}-${Math.round(y)}`;
---

<g filter="url(#f-sombra)">
  <rect x={x - marco} y={y - marco} width={ancho + marco * 2} height={alto + marco * 2} rx="3" fill="url(#g-oro-h)" stroke="#6e4a10" stroke-width="2" />
  <rect x={x - marco * 0.45} y={y - marco * 0.45} width={ancho + marco * 0.9} height={alto + marco * 0.9} fill="none" stroke="#fff0b8" stroke-width="2" opacity="0.7" />
</g>
<clipPath id={id}><rect x={x} y={y} width={ancho} height={alto} /></clipPath>
<g clip-path={`url(#${id})`}>
  {imagen ? <image href={imagen} x={x} y={y} width={ancho} height={alto} preserveAspectRatio="xMidYMid slice" /> : <slot />}
  <rect x={x} y={y} width={ancho} height={alto} fill="#2a1206" opacity="0.12" />
</g>
<rect x={x} y={y} width={ancho} height={alto} fill="none" stroke="#4a2c08" stroke-width="3" />
