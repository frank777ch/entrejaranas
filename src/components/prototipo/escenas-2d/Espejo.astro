---
// Espejo ovalado de marco dorado; (x, y) es el centro del espejo
interface Props {
  x: number;
  y: number;
  ancho?: number;
  alto?: number;
}

const { x, y, ancho = 190, alto = 270 } = Astro.props;
const rx = ancho / 2;
const ry = alto / 2;
---

<g filter="url(#f-sombra)">
  <ellipse cx={x} cy={y} rx={rx + 24} ry={ry + 24} fill="url(#g-oro-h)" stroke="#6e4a10" stroke-width="3" />
  <path
    d={`M${x - 60} ${y - ry - 18} C${x - 40} ${y - ry - 70} ${x - 14} ${y - ry - 40} ${x} ${y - ry - 78} C${x + 14} ${y - ry - 40} ${x + 40} ${y - ry - 70} ${x + 60} ${y - ry - 18} Z`}
    fill="url(#g-oro)"
    stroke="#6e4a10"
    stroke-width="2"
  />
  <circle cx={x} cy={y - ry - 52} r="9" fill="#f6dc8a" />
  <path d={`M${x - 22} ${y + ry + 16} q22 30 44 0`} fill="url(#g-oro)" stroke="#6e4a10" stroke-width="2" />
</g>
<ellipse cx={x} cy={y} rx={rx + 10} ry={ry + 10} fill="none" stroke="#fff0b8" stroke-width="3" opacity="0.7" />
<ellipse cx={x} cy={y} rx={rx} ry={ry} fill="url(#g-espejo)" />
<clipPath id={`cristal-${x}`}><ellipse cx={x} cy={y} rx={rx} ry={ry} /></clipPath>
<g clip-path={`url(#cristal-${x})`} opacity="0.55">
  <path d={`M${x - rx} ${y + 30} L${x + 20} ${y - ry} h40 L${x - rx} ${y + 100}Z`} fill="#fff" />
  <path d={`M${x - rx + 30} ${y + ry} L${x + rx} ${y - 40} v24 L${x - rx + 60} ${y + ry}Z`} fill="#fff" opacity="0.6" />
  <rect x={x - rx} y={y + ry * 0.35} width={ancho} height={ry} fill="#8a6a44" opacity="0.5" />
</g>
