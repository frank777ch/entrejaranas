---
// Sala de la marinera limeña: salón de jarana con muebles de época y balcón.
// Escena ancha (2400 × 900) que se recorre con las flechas.
import { generos } from '../../../data/museo-prototipo';
import Interactivo from './Interactivo.astro';
import Lampara from './Lampara.astro';
import Aplique from './Aplique.astro';
import Cuadro from './Cuadro.astro';
import Arpa from './Arpa.astro';
import Panuelo from './Panuelo.astro';

const sala = generos.find((x) => x.id === 'marinera')!;
const o = (id: string) => sala.objetos.find((x) => x.id === id)!;

const W = 2400;
const piso = 740;
const fuga = { x: 1200, y: 380 };
// Líneas del entablado que van hacia el punto de fuga
const tablas = Array.from({ length: 41 }, (_, i) => {
  const x = i * 60;
  const xb = fuga.x + (x - fuga.x) * ((900 - fuga.y) / (piso - fuga.y));
  return `M${x} ${piso} L${xb.toFixed(1)} 900`;
});
const filas = [758, 780, 808, 842, 884].map((y) => `M0 ${y} H${W}`);
const paneles = Array.from({ length: 12 }, (_, i) => i * 200);
---

<div class="vista-2d" data-vista="sala-marinera" data-ancho="2400">
  <svg viewBox={`0 0 ${W} 900`} width={W} height="900" class="lamina" data-vista="sala-marinera">
    <defs>
      <linearGradient id="g-luz-sala" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a0507" stop-opacity="0.55" />
        <stop offset="0.3" stop-color="#2a0507" stop-opacity="0" />
        <stop offset="1" stop-color="#2a0507" stop-opacity="0.25" />
      </linearGradient>
      <linearGradient id="g-cortina" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#b8892e" />
        <stop offset="0.25" stop-color="#f1d58a" />
        <stop offset="0.5" stop-color="#c49434" />
        <stop offset="0.75" stop-color="#efd185" />
        <stop offset="1" stop-color="#a87a24" />
      </linearGradient>
      <radialGradient id="g-luz-lampara" cx="0.5" cy="0.2" r="0.6">
        <stop offset="0" stop-color="#ffe2a8" stop-opacity="0.35" />
        <stop offset="1" stop-color="#ffe2a8" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Pared de damasco -->
    <rect width={W} height={piso} fill="url(#p-damasco)" />
    <rect width={W} height={piso} fill="url(#g-luz-sala)" />
    <ellipse cx="620" cy="300" rx="560" ry="420" fill="url(#g-luz-lampara)" />
    <ellipse cx="1780" cy="300" rx="560" ry="420" fill="url(#g-luz-lampara)" />

    <!-- Techo y cornisa -->
    <rect width={W} height="64" fill="url(#g-techo)" />
    <rect y="64" width={W} height="22" fill="url(#g-oro)" />
    <path d={`M0 92 ${Array.from({ length: 80 }, () => 'h15 v8 h15 v-8').join(' ')}`} fill="none" stroke="#d9a640" stroke-width="3" opacity="0.8" />

    <!-- Arrimadero de madera -->
    <rect y="590" width={W} height={piso - 590} fill="url(#g-madera)" />
    <rect y="584" width={W} height="10" fill="url(#g-oro)" />
    {
      paneles.map((x) => (
        <g>
          <rect x={x + 18} y="608" width="164" height="116" rx="4" fill="#6b3a18" stroke="#3a1d08" stroke-width="3" />
          <rect x={x + 30} y="620" width="140" height="92" rx="3" fill="none" stroke="#c78a4e" stroke-width="2" opacity="0.6" />
        </g>
      ))
    }

    <!-- Piso de tablas -->
    <rect y={piso} width={W} height={900 - piso} fill="url(#p-tablas)" />
    <rect y={piso} width={W} height={900 - piso} fill="#7a4520" opacity="0.55" />
    <path d={tablas.join(' ') + ' ' + filas.join(' ')} stroke="#3e200b" stroke-width="2" opacity="0.7" />
    <rect y={piso} width={W} height="40" fill="#1c0b03" opacity="0.3" />
    <!-- Alfombra central -->
    <polygon points="900,770 1500,770 1600,880 800,880" fill="#6e0f14" stroke="#d9a640" stroke-width="6" />
    <polygon points="940,782 1460,782 1540,866 860,866" fill="none" stroke="#d9a640" stroke-width="2" opacity="0.8" />

    <!-- Ventana con cortinas (izquierda) -->
    <rect x="70" y="150" width="200" height="420" fill="url(#g-cielo)" />
    <path d="M70 360 h200 M170 150 v420" stroke="#4a2a12" stroke-width="8" />
    <rect x="70" y="150" width="200" height="420" fill="none" stroke="#4a2a12" stroke-width="12" />
    <path d="M40 120 C60 300 40 460 70 600 L130 600 C110 450 120 300 96 120Z" fill="url(#g-cortina)" />
    <path d="M300 120 C280 300 300 460 270 600 L210 600 C230 450 220 300 244 120Z" fill="url(#g-cortina)" />
    <rect x="30" y="108" width="280" height="22" rx="10" fill="url(#g-oro)" />
    <polygon points="100,570 240,570 340,900 20,900" fill="url(#g-rayo)" opacity="0.3" />

    <!-- Balcón (derecha) -->
    <g>
      <rect x="2130" y="150" width="240" height="590" fill="url(#g-madera-osc)" />
      <rect x="2150" y="180" width="200" height="300" fill="url(#g-cielo)" />
      <rect x="2150" y="180" width="200" height="300" fill="url(#p-celosia)" opacity="0.75" />
      <path d="M2250 180 v300 M2150 330 h200" stroke="#3a1d08" stroke-width="8" />
      <rect x="2150" y="500" width="200" height="220" fill="url(#g-madera)" stroke="#3a1d08" stroke-width="4" />
      <rect x="2168" y="518" width="164" height="184" fill="none" stroke="#c78a4e" stroke-width="3" opacity="0.7" />
      <path d="M2130 150 h240 l14 -30 h-268z" fill="url(#g-madera)" />
    </g>

    <Lampara x={620} y={210} escala={0.8} cadena={190} />
    <Lampara x={1780} y={210} escala={0.8} cadena={190} />
    <Aplique x={1010} y={330} escala={0.9} />
    <Aplique x={1390} y={330} escala={0.9} />

    <!-- Sofá de época bajo el cuadro -->
    <g transform="translate(1200 740)">
      <ellipse cx="0" cy="6" rx="250" ry="16" fill="#1c0b03" opacity="0.4" />
      <path d="M-230 -150 C-230 -230 -120 -210 0 -226 C120 -210 230 -230 230 -150 V-90 H-230Z" fill="url(#g-terciopelo)" stroke="url(#g-oro)" stroke-width="8" />
      <rect x="-250" y="-100" width="500" height="60" rx="18" fill="url(#g-terciopelo)" stroke="#5a0a0f" stroke-width="2" />
      <path d="M-250 -110 c-30 0 -30 70 0 70 M250 -110 c30 0 30 70 0 70" fill="url(#g-terciopelo)" stroke="url(#g-oro)" stroke-width="6" />
      <path d="M-220 -40 l-10 40 M220 -40 l10 40 M-120 -40 v36 M120 -40 v36" stroke="url(#g-madera)" stroke-width="12" stroke-linecap="round" />
      <path d="M-160 -170 h0 M-80 -180 h0 M0 -184 h0 M80 -180 h0 M160 -170 h0" stroke="#e9c46a" stroke-width="10" stroke-linecap="round" />
    </g>

    <!-- 1. Traje y manto femenino -->
    <Interactivo id="manto" nombre={o('manto').nombre} cx={430} cy={500} alto={500} iy={430}>
      <ellipse cx="430" cy="752" rx="150" ry="20" fill="#1c0b03" opacity="0.4" />
      <path d="M300 740 h260 v-26 c0 -14 -260 -14 -260 0z" fill="url(#g-madera)" />
      <ellipse cx="430" cy="714" rx="130" ry="14" fill="#9a5f2e" />
      <image href="/prototipos/2d/vestido.webp" x="255" y="246" width="350" height="458" />
    </Interactivo>

    <!-- 2. Arpa -->
    <Interactivo id="arpa" nombre={o('arpa').nombre} cx={810} cy={520} alto={500} iy={540}>
      <Arpa x={830} y={772} escala={1.02} />
    </Interactivo>

    <!-- 5. Cuadro de una pareja bailando -->
    <Interactivo id="cuadro" nombre={o('cuadro').nombre} cx={1200} cy={320} alto={440}>
      <Cuadro x={1094} y={140} ancho={212} alto={360} marco={22} imagen="/prototipos/2d/pareja.webp" />
    </Interactivo>

    <!-- 3. Pañuelo blanco -->
    <Interactivo id="panuelo" nombre={o('panuelo').nombre} cx={1600} cy={560} alto={480} iy={500}>
      <Panuelo x={1600} y={772} escala={1.05} />
    </Interactivo>

    <!-- 4. Abanico -->
    <Interactivo id="abanico" nombre={o('abanico').nombre} cx={1960} cy={540} alto={420} iy={500}>
      <g transform="translate(1960 772)">
        <ellipse cx="0" cy="4" rx="150" ry="14" fill="#1c0b03" opacity="0.4" />
        <path d="M-110 -170 C-120 -110 -86 -60 -100 0 M110 -170 C120 -110 86 -60 100 0" fill="none" stroke="url(#g-madera)" stroke-width="14" stroke-linecap="round" />
        <rect x="-140" y="-190" width="280" height="24" rx="5" fill="#efe8dc" stroke="#b3a68f" stroke-width="2" />
        <path d="M-120 -166 q120 46 240 0" fill="none" stroke="url(#g-oro)" stroke-width="8" />
        <image href="/prototipos/2d/abanico.webp" x="-150" y="-364" width="300" height="174" />
      </g>
    </Interactivo>

    <rect width={W} height="900" fill="url(#g-vineta)" pointer-events="none" />
  </svg>
</div>
