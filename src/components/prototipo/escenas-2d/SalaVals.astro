---
// Sala del vals criollo: salón nocturno de luz tenue, con un balcón abierto sobre la Lima
// de noche y sus farolas. Escena ancha (2400 × 900).
import { generos } from '../../../data/museo-prototipo';
import Interactivo from './Interactivo.astro';
import Aplique from './Aplique.astro';

const sala = generos.find((x) => x.id === 'vals')!;
const o = (id: string) => sala.objetos.find((x) => x.id === id)!;

const W = 2400;
const piso = 740;
const f = (n: number) => n.toFixed(1);

// Parquet en espiga, en perspectiva hacia el balcón
const fuga = { x: 1200, y: 380 };
const juntas = Array.from({ length: 41 }, (_, i) => {
  const x = i * 60;
  const xb = fuga.x + (x - fuga.x) * ((900 - fuga.y) / (piso - fuga.y));
  return `M${x} ${piso} L${f(xb)} 900`;
});
const hiladas = [756, 778, 806, 840, 882].map((y) => `M0 ${y} H${W}`);

// Estrellas fijas sobre la ciudad
const estrellas = Array.from({ length: 40 }, (_, i) => ({
  x: 1010 + ((i * 97) % 380),
  y: 170 + ((i * 61) % 230),
  r: 0.8 + (i % 3) * 0.6,
}));

// Casas de la ciudad (silueta) con ventanas encendidas
const casas = [
  { x: 1010, w: 70, h: 120 },
  { x: 1080, w: 56, h: 150 },
  { x: 1236, w: 64, h: 132 },
  { x: 1300, w: 90, h: 110 },
];
const ventanas = [
  [1024, 470], [1050, 470], [1024, 500], [1094, 446], [1116, 476], [1250, 466], [1276, 496], [1316, 486], [1350, 486], [1350, 516],
];
const farolas = [1040, 1130, 1220, 1310, 1370];

// Surcos del disco de vinilo
const surcos = Array.from({ length: 12 }, (_, i) => 30 + i * 6.5);
---

<div class="vista-2d" data-vista="sala-vals" data-ancho="2400">
  <svg viewBox={`0 0 ${W} 900`} width={W} height="900" class="lamina">
    <defs>
      <linearGradient id="vl-noche" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0b1330" />
        <stop offset="0.65" stop-color="#1d2f5c" />
        <stop offset="1" stop-color="#3a4a7a" />
      </linearGradient>
      <linearGradient id="vl-pared" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#16213f" />
        <stop offset="0.5" stop-color="#22325a" />
        <stop offset="1" stop-color="#1a2747" />
      </linearGradient>
      <linearGradient id="vl-saco" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#1b1b22" />
        <stop offset="0.5" stop-color="#3a3a46" />
        <stop offset="1" stop-color="#16161c" />
      </linearGradient>
      <linearGradient id="vl-tapa" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f3cf8a" />
        <stop offset="0.55" stop-color="#d9a250" />
        <stop offset="1" stop-color="#a86d28" />
      </linearGradient>
      <linearGradient id="vl-vidrio" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#5a6f9e" stop-opacity="0.55" />
        <stop offset="0.5" stop-color="#a7b8dc" stop-opacity="0.25" />
        <stop offset="1" stop-color="#2a3a68" stop-opacity="0.5" />
      </linearGradient>
      <linearGradient id="vl-papel" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fbf3e0" />
        <stop offset="1" stop-color="#e8d9b5" />
      </linearGradient>
      <radialGradient id="vl-luz-calida" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#ffd27a" stop-opacity="0.45" />
        <stop offset="1" stop-color="#ffd27a" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="vl-farol" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fff1c4" stop-opacity="0.95" />
        <stop offset="0.3" stop-color="#ffcf6a" stop-opacity="0.5" />
        <stop offset="1" stop-color="#ffb347" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="vl-luna" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fffbe8" />
        <stop offset="0.3" stop-color="#e9efff" stop-opacity="0.6" />
        <stop offset="1" stop-color="#e9efff" stop-opacity="0" />
      </radialGradient>
      <pattern id="vl-rayas" width="60" height="40" patternUnits="userSpaceOnUse">
        <rect width="60" height="40" fill="#22325a" />
        <rect width="30" height="40" fill="#263862" />
        <path d="M30 0v40" stroke="#c9a24c" stroke-width="1.5" opacity="0.45" />
        <circle cx="15" cy="20" r="3" fill="#c9a24c" opacity="0.35" />
      </pattern>
      <pattern id="vl-alfombra" width="40" height="40" patternUnits="userSpaceOnUse">
        <rect width="40" height="40" fill="#283a6e" />
        <path d="M20 4 L36 20 L20 36 L4 20Z" fill="none" stroke="#c9a24c" stroke-width="2" opacity="0.6" />
        <circle cx="20" cy="20" r="3" fill="#a32a31" />
      </pattern>
      <clipPath id="vl-clip-balcon"><rect x="1010" y="160" width="380" height="480" /></clipPath>
      <clipPath id="vl-clip-disco"><circle cx="0" cy="0" r="110" /></clipPath>
    </defs>

    <!-- Pared con papel rayado -->
    <rect width={W} height={piso} fill="url(#vl-rayas)" />
    <rect width={W} height={piso} fill="url(#vl-pared)" opacity="0.45" />

    <!-- Moldura del techo -->
    <rect width={W} height="60" fill="#0d1428" />
    <rect y="60" width={W} height="20" fill="url(#g-oro)" opacity="0.8" />
    <path d={`M0 86 ${Array.from({ length: 80 }, () => 'h15 v8 h15 v-8').join(' ')}`} fill="none" stroke="#c9a24c" stroke-width="3" opacity="0.6" />

    <!-- Arrimadero oscuro -->
    <rect y="600" width={W} height={piso - 600} fill="url(#g-madera-osc)" />
    <rect y="594" width={W} height="10" fill="url(#g-oro)" opacity="0.8" />
    {
      Array.from({ length: 12 }, (_, i) => i * 200).map((x) => (
        <rect x={x + 20} y="616" width="160" height="108" rx="4" fill="none" stroke="#7a5a3a" stroke-width="2" opacity="0.6" />
      ))
    }

    <!-- Balcón abierto a la ciudad de noche -->
    <g>
      <g clip-path="url(#vl-clip-balcon)">
        <rect x="1010" y="160" width="380" height="480" fill="url(#vl-noche)" />
        {estrellas.map((e) => <circle cx={e.x} cy={e.y} r={e.r} fill="#fff8e6" opacity="0.8" />)}
        <circle cx="1090" cy="230" r="70" fill="url(#vl-luna)" />
        <circle cx="1090" cy="230" r="24" fill="#fffbe8" />
        <circle cx="1100" cy="224" r="22" fill="#1d2f5c" opacity="0.15" />
        <!-- Catedral -->
        <g fill="#0e1630">
          <rect x="1140" y="360" width="100" height="200" />
          <rect x="1136" y="300" width="28" height="80" />
          <rect x="1216" y="300" width="28" height="80" />
          <path d="M1136 300 l14 -34 l14 34z M1216 300 l14 -34 l14 34z" />
          <path d="M1160 360 a30 30 0 0 1 60 0z" />
        </g>
        <path d="M1150 340 h8 M1226 340 h8" stroke="#ffd77a" stroke-width="6" opacity="0.6" />
        <!-- Casas con balcones -->
        {casas.map((c) => <rect x={c.x} y={560 - c.h} width={c.w} height={c.h} fill="#141f40" />)}
        {ventanas.map(([x, y]) => <rect x={x} y={y} width="12" height="16" fill="#ffcf6a" opacity="0.85" />)}
        <rect x="1010" y="556" width="380" height="84" fill="#0b1228" />
        <!-- Farolas de la calle -->
        {
          farolas.map((x) => (
            <g>
              <circle cx={x} cy="532" r="28" fill="url(#vl-farol)" />
              <rect x={x - 2} y="536" width="4" height="34" fill="#05080f" />
              <rect x={x - 6} y="524" width="12" height="14" rx="2" fill="#ffd77a" />
            </g>
          ))
        }
      </g>
      <!-- Marco y puertas vidrieras abiertas -->
      <rect x="996" y="146" width="408" height="508" fill="none" stroke="url(#g-madera)" stroke-width="28" />
      <polygon points="990,140 900,176 900,640 990,660" fill="#3b2412" stroke="#1a0d05" stroke-width="3" />
      <polygon points="1410,140 1500,176 1500,640 1410,660" fill="#3b2412" stroke="#1a0d05" stroke-width="3" />
      {[0, 1, 2, 3].map((i) => (
        <g>
          <polygon points={`912,${196 + i * 108} 980,${178 + i * 106} 980,${270 + i * 106} 912,${284 + i * 108}`} fill="url(#vl-vidrio)" />
          <polygon points={`1488,${196 + i * 108} 1420,${178 + i * 106} 1420,${270 + i * 106} 1488,${284 + i * 108}`} fill="url(#vl-vidrio)" />
        </g>
      ))}
      <!-- Baranda del balcón -->
      <rect x="1010" y="566" width="380" height="14" fill="url(#g-madera)" />
      {Array.from({ length: 16 }, (_, i) => 1022 + i * 24).map((x) => (
        <path d={`M${x} 580 v74`} stroke="#3b2412" stroke-width="8" />
      ))}
      <rect x="1010" y="640" width="380" height="16" fill="url(#g-madera)" />
      <rect x="980" y="650" width="440" height="22" rx="3" fill="url(#g-madera-osc)" />
      <!-- Luz de luna sobre el piso -->
      <polygon points="1010,672 1390,672 1640,900 760,900" fill="#bcd0ff" opacity="0.12" />
    </g>

    <Aplique x={620} y={330} escala={0.9} />
    <Aplique x={1780} y={330} escala={0.9} />

    <!-- Piso de parquet con alfombra -->
    <rect y={piso} width={W} height={900 - piso} fill="#4a2a14" />
    <path d={juntas.join(' ') + ' ' + hiladas.join(' ')} stroke="#2a160a" stroke-width="2" opacity="0.7" />
    <rect y={piso} width={W} height="40" fill="#05080f" opacity="0.35" />
    <polygon points="820,776 1580,776 1700,890 700,890" fill="url(#vl-alfombra)" />
    <polygon points="820,776 1580,776 1700,890 700,890" fill="none" stroke="#c9a24c" stroke-width="5" />

    <!-- Busto de Felipe Pinglo Alva (adorno) -->
    <g>
      <ellipse cx="2240" cy="410" rx="200" ry="240" fill="url(#vl-luz-calida)" />
      <ellipse cx="2240" cy="768" rx="110" ry="12" fill="#05080f" opacity="0.5" />
      <rect x="2170" y="500" width="140" height="262" fill="url(#g-madera)" />
      <rect x="2156" y="488" width="168" height="22" rx="3" fill="url(#g-madera-osc)" />
      <rect x="2156" y="748" width="168" height="20" rx="3" fill="url(#g-madera-osc)" />
      <rect x="2186" y="560" width="108" height="46" rx="3" fill="url(#g-oro)" />
      <text x="2240" y="580" text-anchor="middle" font-family="'Libre Baskerville', Georgia, serif" font-size="12" font-weight="700" fill="#3a2408">Felipe Pinglo</text>
      <text x="2240" y="597" text-anchor="middle" font-family="'Libre Baskerville', Georgia, serif" font-size="11" fill="#3a2408">1899 – 1936</text>
      <image href="/prototipos/2d/pinglo.webp" x="2144" y="296" width="192" height="196" preserveAspectRatio="xMidYMax meet" />
    </g>

    <!-- 1. Saco elegante en un galán de noche -->
    <Interactivo id="saco" nombre={o('saco').nombre} cx={400} cy={480} alto={520} iy={470}>
      <g transform="translate(400 772)">
        <ellipse cx="0" cy="0" rx="130" ry="14" fill="#05080f" opacity="0.5" />
        <path d="M-80 -6 L0 -40 L80 -6" fill="none" stroke="url(#g-madera)" stroke-width="12" stroke-linecap="round" />
        <rect x="-7" y="-440" width="14" height="410" fill="url(#g-madera-h)" />
        <!-- Pantalón doblado en la barra -->
        <rect x="-80" y="-176" width="160" height="12" rx="6" fill="url(#g-madera)" />
        <path d="M-70 -170 h140 v60 c0 10 -140 10 -140 0z" fill="#22222a" />
        <path d="M-70 -150 h140" stroke="#3a3a46" stroke-width="2" />
        <!-- Percha -->
        <path d="M-110 -416 C-60 -446 60 -446 110 -416" fill="none" stroke="url(#g-madera)" stroke-width="12" stroke-linecap="round" />
        <!-- Camisa blanca y corbata michi -->
        <path d="M-40 -432 L40 -432 L44 -260 L-44 -260Z" fill="#f6f1e6" />
        <path d="M-16 -430 L0 -400 L16 -430" fill="#fff" stroke="#d7cdb8" stroke-width="2" />
        <path d="M-22 -396 L-2 -386 L-22 -376Z M22 -396 L2 -386 L22 -376Z" fill="#111" />
        <circle cx="0" cy="-386" r="5" fill="#111" />
        <!-- Saco -->
        <path d="M-112 -418 C-130 -380 -128 -300 -122 -228 L-36 -224 L0 -330 L36 -224 L122 -228 C128 -300 130 -380 112 -418 C80 -432 50 -436 26 -432 L0 -330 L-26 -432 C-50 -436 -80 -432 -112 -418Z" fill="url(#vl-saco)" />
        <path d="M-26 -432 L-58 -380 L-36 -366 L-46 -300 L0 -330Z M26 -432 L58 -380 L36 -366 L46 -300 L0 -330Z" fill="#2a2a34" stroke="#4a4a58" stroke-width="2" />
        <path d="M-122 -228 L-36 -224 M122 -228 L36 -224" stroke="#0d0d12" stroke-width="3" />
        <circle cx="-12" cy="-290" r="5" fill="#8a8a96" />
        <circle cx="-14" cy="-256" r="5" fill="#8a8a96" />
        <path d="M60 -350 l30 -6 l2 14 l-30 6z" fill="#f6f1e6" />
        <path d="M64 -352 l8 -14 l6 12 l6 -14 l4 12" fill={sala.color} />
        <!-- Sombrero en lo alto -->
        <ellipse cx="0" cy="-452" rx="70" ry="14" fill="#1b1b22" />
        <path d="M-44 -456 C-46 -500 -30 -514 0 -514 C30 -514 46 -500 44 -456Z" fill="#26262e" />
        <path d="M-44 -470 C-20 -462 20 -462 44 -470 L44 -458 C20 -450 -20 -450 -44 -458Z" fill={sala.color} />
        <path d="M-10 -512 C-4 -500 4 -500 10 -512" stroke="#0d0d12" stroke-width="3" fill="none" />
      </g>
    </Interactivo>

    <!-- 2. Guitarra criolla -->
    <Interactivo id="guitarra" nombre={o('guitarra').nombre} cx={790} cy={480} alto={560} iy={560}>
      <g transform="translate(790 770) rotate(-8)">
        <ellipse cx="0" cy="4" rx="110" ry="12" fill="#05080f" opacity="0.5" />
        <path d="M-60 0 L0 -60 L60 0 M0 -60 V-150" stroke="#2a2a30" stroke-width="8" stroke-linecap="round" fill="none" />
        <!-- Clavijero y mástil -->
        <rect x="-16" y="-560" width="32" height="250" fill="#3a1d0c" />
        <path d="M-22 -560 L22 -560 L26 -634 L-26 -634Z" fill="#2a140a" />
        {[-604, -586, -568].map((y) => (
          <g>
            <rect x="-38" y={y - 4} width="14" height="8" rx="3" fill="#e8dcc0" />
            <rect x="24" y={y - 4} width="14" height="8" rx="3" fill="#e8dcc0" />
          </g>
        ))}
        {Array.from({ length: 10 }, (_, i) => -540 + i * 22).map((y) => <path d={`M-16 ${y} h32`} stroke="#c9b48a" stroke-width="2" />)}
        <!-- Caja -->
        <path d="M0 -330 C-56 -330 -90 -306 -86 -262 C-82 -226 -60 -212 -64 -190 C-68 -168 -118 -150 -118 -90 C-118 -24 -62 6 0 6 C62 6 118 -24 118 -90 C118 -150 68 -168 64 -190 C60 -212 82 -226 86 -262 C90 -306 56 -330 0 -330Z" fill="#5a2a12" />
        <path d="M0 -322 C-50 -322 -80 -300 -78 -262 C-74 -228 -52 -214 -56 -190 C-60 -168 -110 -152 -110 -92 C-110 -32 -58 -2 0 -2 C58 -2 110 -32 110 -92 C110 -152 60 -168 56 -190 C52 -214 74 -228 78 -262 C80 -300 50 -322 0 -322Z" fill="url(#vl-tapa)" />
        <circle cx="0" cy="-200" r="34" fill="#2a140a" />
        <circle cx="0" cy="-200" r="42" fill="none" stroke="#7a3a1a" stroke-width="5" />
        <circle cx="0" cy="-200" r="48" fill="none" stroke={sala.color} stroke-width="3" />
        <rect x="-40" y="-92" width="80" height="16" rx="4" fill="#3a1d0c" />
        <path d="M-12 -560 V-84 M-7 -560 V-84 M-2 -560 V-84 M3 -560 V-84 M8 -560 V-84 M13 -560 V-84" stroke="#f3ead6" stroke-width="1.2" opacity="0.85" />
        <ellipse cx="-50" cy="-120" rx="24" ry="50" fill="#fff6dc" opacity="0.18" />
      </g>
    </Interactivo>

    <!-- 4. Farol antiguo colgado en el vano del balcón -->
    <Interactivo id="farol" nombre={o('farol').nombre} cx={1200} cy={300} alto={320}>
      <g transform="translate(1200 300)">
        <circle cx="0" cy="40" r="170" fill="url(#vl-farol)" />
        <path d="M0 -154 V-98" stroke="#1a1a20" stroke-width="5" stroke-dasharray="10 6" />
        <rect x="-16" y="-160" width="32" height="10" rx="3" fill="#1a1a20" />
        <circle cx="0" cy="-98" r="10" fill="none" stroke="#1a1a20" stroke-width="5" />
        <path d="M-34 -50 L0 -86 L34 -50Z" fill="#1a1a20" />
        <path d="M-40 -50 h80 v10 h-80z" fill="#2a2a30" />
        <path d="M-36 -40 L-28 60 L28 60 L36 -40Z" fill="#ffd77a" />
        <path d="M-12 -40 L-10 60 M12 -40 L10 60" stroke="#1a1a20" stroke-width="4" />
        <path d="M-36 -40 L-28 60 M36 -40 L28 60" stroke="#1a1a20" stroke-width="6" />
        <path d="M-32 10 h64" stroke="#1a1a20" stroke-width="3" />
        <path d="M0 -10 c-10 -12 -4 -26 0 -34 c4 8 10 22 0 34z" fill="#fff6d0" />
        <path d="M-34 60 h68 l-12 18 h-44z" fill="#1a1a20" />
        <circle cx="0" cy="86" r="7" fill="#1a1a20" />
      </g>
    </Interactivo>

    <!-- 3. Partitura en su atril -->
    <Interactivo id="partitura" nombre={o('partitura').nombre} cx={1610} cy={480} alto={500} iy={430}>
      <g transform="translate(1610 772)">
        <ellipse cx="0" cy="0" rx="120" ry="12" fill="#05080f" opacity="0.5" />
        <path d="M-90 -4 L0 -70 L90 -4 M0 -70 L0 -14" stroke="url(#g-bronce)" stroke-width="8" stroke-linecap="round" fill="none" />
        <rect x="-6" y="-330" width="12" height="270" fill="url(#g-bronce)" />
        <!-- Atril inclinado -->
        <polygon points="-150,-334 150,-334 160,-300 -160,-300" fill="url(#g-madera)" stroke="#2a140a" stroke-width="3" />
        <polygon points="-150,-334 150,-334 120,-556 -120,-556" fill="#3b2412" stroke="#2a140a" stroke-width="3" />
        <!-- Hoja con pentagramas -->
        <polygon points="-126,-344 126,-344 100,-546 -100,-546" fill="url(#vl-papel)" />
        <text x="0" y="-516" text-anchor="middle" font-family="'Libre Baskerville', Georgia, serif" font-size="18" font-weight="700" fill="#2a1a10">El plebeyo</text>
        <text x="0" y="-498" text-anchor="middle" font-family="'Libre Baskerville', Georgia, serif" font-size="10" font-style="italic" fill="#4a3a2a">Vals · Felipe Pinglo Alva</text>
        {
          [0, 1, 2, 3, 4].map((p) => {
            const y0 = -480 + p * 30;
            const k = (y0 + 546) / 202;
            const x0 = -100 - 26 * k + 8;
            const x1 = 100 + 26 * k - 8;
            return (
              <g>
                {[0, 1, 2, 3, 4].map((l) => (
                  <path d={`M${f(x0)} ${y0 + l * 3.6} H${f(x1)}`} stroke="#4a3a2a" stroke-width="0.9" />
                ))}
                {[0.12, 0.24, 0.36, 0.5, 0.62, 0.76, 0.88].map((t, i) => {
                  const x = x0 + (x1 - x0) * t;
                  const y = y0 + ((i * 5 + p * 3) % 5) * 3.6;
                  return (
                    <g>
                      <ellipse cx={f(x)} cy={y} rx="3.2" ry="2.4" fill="#2a1a10" />
                      <path d={`M${f(x + 3)} ${y} v-12`} stroke="#2a1a10" stroke-width="1" />
                    </g>
                  );
                })}
              </g>
            );
          })
        }
        <path d="M-126 -344 L-100 -546" stroke="#c9b48a" stroke-width="2" />
      </g>
    </Interactivo>

    <!-- 5. Disco de vinilo con su carátula -->
    <Interactivo id="disco" nombre={o('disco').nombre} cx={1960} cy={540} alto={380} iy={520}>
      <g transform="translate(1960 772)">
        <ellipse cx="0" cy="0" rx="170" ry="14" fill="#05080f" opacity="0.5" />
        <!-- Mesita -->
        <rect x="-150" y="-226" width="300" height="20" rx="4" fill="url(#g-madera)" />
        <path d="M-130 -206 L-138 -6 M130 -206 L138 -6" stroke="url(#g-madera-osc)" stroke-width="14" stroke-linecap="round" />
        <path d="M-130 -100 H130" stroke="url(#g-madera-osc)" stroke-width="8" />
        <!-- Carátula -->
        <g transform="translate(-30 -236) rotate(-6)">
          <rect x="-110" y="-230" width="230" height="230" fill={sala.color} stroke="#0d1428" stroke-width="3" />
          <rect x="-96" y="-216" width="202" height="202" fill="none" stroke="#c9a24c" stroke-width="2" />
          <circle cx="-50" cy="-120" r="34" fill="#e9b25a" opacity="0.9" />
          <path d="M-40 -60 c10 -40 30 -60 40 -64 c6 20 4 40 -6 64z M14 -60 c4 -30 18 -54 32 -60 c4 22 0 40 -10 60z" fill="#0d1428" />
          <text x="-92" y="-190" font-family="'Libre Baskerville', Georgia, serif" font-size="19" font-weight="700" fill="#fbf3e0">Valses</text>
          <text x="-92" y="-166" font-family="'Libre Baskerville', Georgia, serif" font-size="19" font-weight="700" fill="#fbf3e0">criollos</text>
        </g>
        <!-- Disco asomando -->
        <g transform="translate(70 -346)">
          <circle r="112" fill="#0d0d10" />
          <g clip-path="url(#vl-clip-disco)">
            {surcos.map((r) => <circle r={r + 30} fill="none" stroke="#2a2a32" stroke-width="1.5" />)}
            <path d="M-110 -40 L110 40 L110 70 L-110 -10Z" fill="#fff" opacity="0.08" />
          </g>
          <circle r="38" fill="#a32a31" />
          <circle r="34" fill="none" stroke="#f2c27a" stroke-width="1.5" />
          <text y="-8" text-anchor="middle" font-family="Archivo, system-ui, sans-serif" font-size="9" font-weight="700" fill="#fbf3e0">VALS</text>
          <text y="12" text-anchor="middle" font-family="Archivo, system-ui, sans-serif" font-size="7" fill="#fbf3e0">33 ⅓ RPM</text>
          <circle r="4" fill="#0d0d10" />
        </g>
      </g>
    </Interactivo>

    <!-- Penumbra del salón -->
    <rect width={W} height="900" fill="url(#g-vineta)" pointer-events="none" />
  </svg>
</div>
