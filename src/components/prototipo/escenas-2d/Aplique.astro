---
// Candelabro de pared con dos velas; (x, y) es el centro de la placa
interface Props {
  x: number;
  y: number;
  escala?: number;
}

const { x, y, escala = 1 } = Astro.props;
---

<g transform={`translate(${x} ${y}) scale(${escala})`}>
  <circle cx="0" cy="-52" r="95" fill="url(#g-halo)" opacity="0.8" />
  <ellipse cx="0" cy="0" rx="14" ry="30" fill="url(#g-oro)" stroke="#7a5212" stroke-width="2" />
  <path d="M0 10 C-20 14 -44 8 -46 -16 M0 10 C20 14 44 8 46 -16" fill="none" stroke="url(#g-oro)" stroke-width="6" stroke-linecap="round" />
  <rect x="-56" y="-20" width="20" height="8" rx="2" fill="url(#g-oro)" />
  <rect x="36" y="-20" width="20" height="8" rx="2" fill="url(#g-oro)" />
  <rect x="-51" y="-52" width="10" height="32" rx="2" fill="#fbf3e0" />
  <rect x="41" y="-52" width="10" height="32" rx="2" fill="#fbf3e0" />
  <path d="M-46 -54 c-6 -8 -2 -16 0 -22 c2 6 6 14 0 22z" fill="#ffcf5a" />
  <path d="M46 -54 c-6 -8 -2 -16 0 -22 c2 6 6 14 0 22z" fill="#ffcf5a" />
</g>
