      <linearGradient id="fj-tierra" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#a3623a" />
        <stop offset="1" stop-color="#7a4224" />
      </linearGradient>
      <linearGradient id="fj-puerta" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#1f5e78" />
        <stop offset="0.5" stop-color="#2f7d99" />
        <stop offset="1" stop-color="#1c5269" />
      </linearGradient>
      <linearGradient id="fj-cajon" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#6e3a17" />
        <stop offset="0.45" stop-color="#b8743a" />
        <stop offset="1" stop-color="#6a3514" />
      </linearGradient>
      <linearGradient id="fj-falda" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#b8361f" />
        <stop offset="0.35" stop-color="#e8622a" />
        <stop offset="0.7" stop-color="#f08a34" />
        <stop offset="1" stop-color="#b8461f" />
      </linearGradient>
      <linearGradient id="fj-falda2" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#d99a1c" />
        <stop offset="0.5" stop-color="#f6c43e" />
        <stop offset="1" stop-color="#cf8e16" />
