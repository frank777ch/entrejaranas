---
// Sala del festejo: patio de callejón afroperuano, con paredes de adobe y ramada de caña.
// Escena ancha (2400 × 900) que se recorre con las flechas.
import { generos } from '../../../data/museo-prototipo';
import Interactivo from './Interactivo.astro';
import Maceta from './Maceta.astro';

const sala = generos.find((x) => x.id === 'festejo')!;
const o = (id: string) => sala.objetos.find((x) => x.id === id)!;

const W = 2400;
const piso = 740;
const canas = Array.from({ length: Math.ceil(W / 13) }, (_, i) => i * 13);
const colores = ['#c4561f', '#f2b632', '#2f7a4a', '#f6efe2', '#a32a31', '#2f5a8a'];

// Banderines colgados en catenaria entre dos puntos
function banderines(x0: number, y0: number, x1: number, y1: number, caida: number, n: number, des = 0) {
  const punto = (t: number) => [x0 + (x1 - x0) * t, y0 + (y1 - y0) * t + caida * 4 * t * (1 - t)];
  const cuerda = Array.from({ length: 41 }, (_, i) => punto(i / 40).map((v) => v.toFixed(1)).join(',')).join(' ');
  const flags = Array.from({ length: n }, (_, i) => {
    const t = (i + 0.5) / n;
    const [x, y] = punto(t);
    const [xa, ya] = punto(t - 0.35 / n);
    const [xb, yb] = punto(t + 0.35 / n);
    return { d: `M${xa.toFixed(1)} ${ya.toFixed(1)} L${xb.toFixed(1)} ${yb.toFixed(1)} L${x.toFixed(1)} ${(y + 46).toFixed(1)}Z`, c: colores[(i + des) % colores.length] };
  });
  return { cuerda, flags };
}
const tiras = [banderines(-20, 150, 1210, 140, 80, 18), banderines(1190, 140, 2420, 160, 90, 18, 3)];

// Falda de festejo: tres vuelos con borde ondulado, más abierta a la izquierda (como en un giro)
const izq = (t: number) => [-38 - 222 * t, -300 + 236 * t];
const der = (t: number) => [38 + 204 * t, -300 + 196 * t];
const f = (n: number) => n.toFixed(1);
function onda(t: number) {
  const [x0, y0] = izq(t);
  const [x1, y1] = der(t);
  const n = Math.round(5 + 6 * t);
  let d = '';
  for (let i = 0; i < n; i++) {
    const a = i / n;
    const b = (i + 1) / n;
    const xm = x0 + (x1 - x0) * ((a + b) / 2);
    const ym = y0 + (y1 - y0) * ((a + b) / 2) + 26 * t + 4;
    d += ` Q${f(xm)} ${f(ym)} ${f(x0 + (x1 - x0) * b)} ${f(y0 + (y1 - y0) * b)}`;
  }
  return d;
}
const vuelo = (t: number) => `M-38 -300 L${izq(t).map(f).join(' ')}${onda(t)} L38 -300 Z`;
const borde = (t: number) => `M${izq(t).map(f).join(' ')}${onda(t)}`;
const pliegues = (t: number) =>
  [0.18, 0.36, 0.54, 0.72, 0.88]
    .map((k) => {
      const [x0, y0] = izq(t);
      const [x1, y1] = der(t);
      const x = x0 + (x1 - x0) * k;
      const y = y0 + (y1 - y0) * k + 10 * t;
      return `M${f(-30 + 60 * k)} -296 Q${f(x * 0.55)} ${f(-300 + (y + 300) * 0.4)} ${f(x)} ${f(y)}`;
    })
    .join(' ');
const volante = `M-66 -432 C-40 -402 40 -402 66 -432 C72 -416 70 -400 62 -390 C30 -372 -30 -372 -62 -390 C-70 -400 -72 -416 -66 -432Z`;

// Ladrillos de adobe que asoman donde se cayó el enlucido
const parches = [
  { x: 520, y: 170, w: 170, h: 110 },
  { x: 1340, y: 470, w: 150, h: 90 },
  { x: 1880, y: 160, w: 200, h: 120 },
  { x: 940, y: 520, w: 120, h: 70 },
];
---

<div class="vista-2d" data-vista="sala-festejo" data-ancho="2400">
  <svg viewBox={`0 0 ${W} 900`} width={W} height="900" class="lamina">
    <defs>
      <linearGradient id="fj-cielo" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e9894a" />
        <stop offset="0.6" stop-color="#f7b977" />
        <stop offset="1" stop-color="#ffe0a6" />
      </linearGradient>
      <linearGradient id="fj-pared" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e7a466" />
        <stop offset="0.6" stop-color="#d88a4c" />
        <stop offset="1" stop-color="#c06c36" />
