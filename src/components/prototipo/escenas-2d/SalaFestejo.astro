        <polygon points="244,450 226,486 226,604 244,640" fill="#7a3a8a" />
        <polygon points="118,300 150,360 150,420 118,380" fill="#3b6f3a" opacity="0.8" />
        <path d="M70 330 Q180 380 290 320" fill="none" stroke="#4a2410" stroke-width="2" />
        {[0, 1, 2, 3, 4, 5].map((i) => <path d={`M${88 + i * 34} ${342 + Math.sin(i) * 6} l14 0 l-7 22z`} fill={colores[i]} />)}
        <rect x="150" y="420" width="60" height="180" fill="#ffe8b8" opacity="0.6" />
      </g>
      <rect x="40" y="220" width="280" height="26" fill="url(#g-madera)" />
