      <path d="M2260 316 v424" stroke="#163f52" stroke-width="5" />
      {[0, 1].map((c) => [0, 1, 2].map((f) => <rect x={2190 + c * 84} y={336 + f * 132} width="56" height="110" rx="4" fill="none" stroke="#7fc0d6" stroke-width="3" opacity="0.6" />))}
      <circle cx="2248" cy="540" r="7" fill="url(#g-bronce)" />
      <circle cx="2272" cy="540" r="7" fill="url(#g-bronce)" />
      <rect x="2148" y="288" width="224" height="20" fill="url(#g-madera)" />
      <polygon points="2176,740 2344,740 2400,900 2120,900" fill="#2a1206" opacity="0.18" />
    </g>

    <!-- Ramada de caña -->
    <rect width={W} height="118" fill="#b88a4a" />
    <path d={canas.map((x) => `M${x + 4} 0 V112`).join(' ')} stroke="#e2bf7a" stroke-width="8" />
    <path d={canas.map((x) => `M${x + 9} 0 V112`).join(' ')} stroke="#8a6230" stroke-width="2" opacity="0.7" />
    <rect y="36" width={W} height="16" fill="url(#g-madera-osc)" />
    <rect y="104" width={W} height="20" fill="url(#g-madera)" />
    <rect y="124" width={W} height="70" fill="url(#fj-sombra-ramada)" />
    {[180, 780, 1420, 2060].map((x) => <rect x={x} y="0" width="22" height="124" fill="url(#g-madera-osc)" />)}

    <!-- Banderines -->
    {
      tiras.map((t) => (
        <g>
          <polyline points={t.cuerda} fill="none" stroke="#4a2410" stroke-width="2.5" />
          {t.flags.map((f) => (
            <path d={f.d} fill={f.c} stroke="#00000022" stroke-width="1" />
          ))}
        </g>
      ))
    }

    <!-- Faroles de lata colgados de la ramada -->
    {
      [760, 1640].map((x) => (
        <g>
          <circle cx={x} cy="268" r="120" fill="url(#fj-farol)" />
          <line x1={x} y1="124" x2={x} y2="226" stroke="#3a1a08" stroke-width="3" />
          <path d={`M${x - 20} 230 h40 l-6 -12 h-28z`} fill="#3a2a1a" />
          <rect x={x - 17} y="232" width="34" height="52" rx="3" fill="#ffd77a" stroke="#3a2a1a" stroke-width="4" />
          <path d={`M${x} 232 v52 M${x - 17} 258 h34`} stroke="#3a2a1a" stroke-width="2.5" />
          <path d={`M${x - 20} 286 h40 l-8 12 h-24z`} fill="#3a2a1a" />
        </g>
      ))
    }

    <!-- Piso de tierra apisonada -->
    <rect y={piso} width={W} height={900 - piso} fill="url(#fj-tierra)" />
    <rect y={piso} width={W} height={900 - piso} fill="url(#fj-grano)" />
    <rect y={piso} width={W} height="34" fill="#3a1606" opacity="0.28" />
    <!-- Camino de ladrillos -->
    <polygon points="980,900 1060,744 1340,744 1420,900" fill="#b4643a" />
    {
      [760, 790, 826, 868].map((y) => {
        const t = (y - 744) / 156;
        return <path d={`M${1060 - 80 * t} ${y} H${1340 + 80 * t}`} stroke="#7a3a1c" stroke-width="3" />;
      })
    }
    <path d="M1130 744 L1100 900 M1200 744 V900 M1270 744 L1300 900" stroke="#7a3a1c" stroke-width="3" />

    <Maceta x={2050} y={762} escala={1.05} />

    <!-- Cajón (adorno) bajo la máscara -->
    <g transform="translate(1200 760)">
      <ellipse cx="0" cy="0" rx="120" ry="14" fill="#2a1206" opacity="0.4" />
      <polygon points="-82,-226 82,-226 96,-212 96,-6 -82,-6" fill="url(#fj-cajon)" stroke="#3a1a08" stroke-width="3" />
      <polygon points="82,-226 96,-212 96,-6 82,-6" fill="#5a2c10" />
      <rect x="-82" y="-226" width="164" height="18" fill="#c78a4e" />
      <path d="M-70 -196 h144 M-70 -150 h144 M-70 -100 h144 M-70 -50 h144" stroke="#7a4220" stroke-width="2" opacity="0.5" />
      <circle cx="0" cy="-118" r="30" fill="#2a1206" />
      <circle cx="0" cy="-118" r="30" fill="none" stroke="#e2b07a" stroke-width="3" />
    </g>

    <!-- 1. Falda amplia -->
    <Interactivo id="falda" nombre={o('falda').nombre} cx={430} cy={500} alto={500} iy={560}>
      <g transform="translate(430 760)">
        <ellipse cx="0" cy="-6" rx="170" ry="16" fill="#2a1206" opacity="0.4" />
        <path d="M-70 -10 L0 -48 L70 -10" fill="none" stroke="url(#g-madera-osc)" stroke-width="10" stroke-linecap="round" />
        <rect x="-6" y="-120" width="12" height="80" fill="url(#g-madera-osc)" />
        <!-- Falda de tres vuelos, abierta como en un giro -->
        <path d={vuelo(1)} fill="#a32a31" />
        <path d={pliegues(1)} fill="none" stroke="#6e1418" stroke-width="3" opacity="0.45" />
        <path d={borde(1)} fill="none" stroke="#fbf3e0" stroke-width="9" />
        <path d={borde(1)} fill="none" stroke="#e7c98a" stroke-width="2" stroke-dasharray="3 5" />
        <path d={vuelo(0.68)} fill="url(#fj-falda2)" />
        <path d={pliegues(0.68)} fill="none" stroke="#a8700e" stroke-width="3" opacity="0.45" />
        <path d={borde(0.68)} fill="none" stroke="#fbf3e0" stroke-width="7" />
        <path d={vuelo(0.38)} fill="url(#fj-falda)" />
        <path d={pliegues(0.38)} fill="none" stroke="#8e2a14" stroke-width="3" opacity="0.45" />
        <path d={borde(0.38)} fill="none" stroke="#fbf3e0" stroke-width="6" />
        <!-- Maniquí con blusa de hombros descubiertos -->
        <path d="M-40 -300 C-46 -330 -60 -370 -58 -404 C-56 -428 -40 -440 -14 -446 L14 -446 C40 -440 56 -428 58 -404 C60 -370 46 -330 40 -300Z" fill="#fbf3e0" />
        <path d="M-40 -300 C-46 -330 -60 -370 -58 -404 C-56 -428 -40 -440 -14 -446 L-4 -446 C-24 -420 -36 -360 -26 -300Z" fill="#e6dac4" />
        <path d="M-14 -446 C-8 -462 8 -462 14 -446Z" fill="#c9a77a" />
        <rect x="-9" y="-486" width="18" height="34" rx="5" fill="url(#g-madera)" />
        <circle cx="0" cy="-494" r="14" fill="url(#g-madera)" />
        <path d={volante} fill="#fff" stroke="#e0d2b8" stroke-width="2" />
        <path d="M-64 -414 q9 10 18 0 q9 10 18 0 q9 10 18 0 q9 10 18 0 q9 10 18 0 q9 10 18 0 q9 10 18 0" fill="none" stroke="#e8622a" stroke-width="3" />
        <rect x="-44" y="-318" width="88" height="22" rx="6" fill="#a32a31" />
        <path d="M-44 -307 h88" stroke="#f2b632" stroke-width="4" />
        <path d="M34 -310 c30 10 36 46 26 70 M40 -300 c18 16 14 40 6 56" fill="none" stroke="#a32a31" stroke-width="8" stroke-linecap="round" />
      </g>
    </Interactivo>

    <!-- 2. Quijada de burro -->
    <Interactivo id="quijada" nombre={o('quijada').nombre} cx={830} cy={560} alto={380} iy={560}>
      <g transform="translate(830 760)">
        <ellipse cx="0" cy="0" rx="190" ry="16" fill="#2a1206" opacity="0.4" />
        <rect x="-170" y="-176" width="340" height="24" rx="4" fill="url(#g-madera)" />
        <rect x="-170" y="-156" width="340" height="12" fill="#3a1a08" opacity="0.4" />
        <path d="M-150 -152 L-160 0 M150 -152 L160 0 M-110 -152 L-104 -20 M110 -152 L104 -20" stroke="url(#g-madera-osc)" stroke-width="14" stroke-linecap="round" />
        <rect x="-150" y="-180" width="300" height="8" rx="3" fill="#a32a31" />
        <image href="/prototipos/2d/quijada.webp" x="-150" y="-344" width="300" height="166" />
        <path d="M120 -184 l70 -80" stroke="#c9a46a" stroke-width="8" stroke-linecap="round" />
        <path d="M120 -184 l70 -80" stroke="#7a5a2a" stroke-width="2" />
      </g>
    </Interactivo>

    <!-- 4. Máscara festiva -->
    <Interactivo id="mascara" nombre={o('mascara').nombre} cx={1200} cy={330} alto={330}>
      <g transform="translate(1200 330)">
        <line x1="0" y1="-160" x2="0" y2="-120" stroke="#3a1a08" stroke-width="3" />
        <circle cx="0" cy="-162" r="6" fill="url(#g-bronce)" />
        <!-- Cuernos -->
        <path d="M-70 -90 C-120 -130 -150 -190 -120 -230 C-110 -180 -80 -150 -40 -120Z" fill="#f3e2bd" stroke="#8a6a3a" stroke-width="3" />
        <path d="M70 -90 C120 -130 150 -190 120 -230 C110 -180 80 -150 40 -120Z" fill="#f3e2bd" stroke="#8a6a3a" stroke-width="3" />
        <path d="M-100 -150 l14 6 M-112 -176 l14 4 M100 -150 l-14 6 M112 -176 l-14 4" stroke="#8a6a3a" stroke-width="3" />
        <!-- Barba de fibra -->
        <path d="M-80 40 C-90 120 -50 160 0 170 C50 160 90 120 80 40Z" fill="#2b1608" />
        <path d="M-70 60 l-6 80 M-50 60 l-4 96 M-30 70 l-2 96 M-10 70 v100 M10 70 v100 M30 70 l2 96 M50 60 l4 96 M70 60 l6 80" stroke="#5a3418" stroke-width="3" />
        <!-- Rostro -->
        <path d="M-100 -60 C-110 -130 -50 -150 0 -150 C50 -150 110 -130 100 -60 C96 0 70 60 0 72 C-70 60 -96 0 -100 -60Z" fill="#c62c25" stroke="#7a1410" stroke-width="4" />
        <path d="M-84 -70 C-80 -120 -40 -136 0 -136 C30 -136 60 -126 74 -104" fill="none" stroke="#ef6a4a" stroke-width="6" opacity="0.6" />
        <!-- Cejas y ojos -->
        <path d="M-82 -80 C-60 -104 -26 -100 -12 -78 M82 -80 C60 -104 26 -100 12 -78" fill="none" stroke="#1a0b05" stroke-width="10" stroke-linecap="round" />
        <ellipse cx="-44" cy="-52" rx="26" ry="20" fill="#fff8e6" stroke="#1a0b05" stroke-width="4" />
        <ellipse cx="44" cy="-52" rx="26" ry="20" fill="#fff8e6" stroke="#1a0b05" stroke-width="4" />
        <circle cx="-40" cy="-50" r="9" fill="#1a0b05" />
        <circle cx="48" cy="-50" r="9" fill="#1a0b05" />
        <!-- Nariz y boca con dientes -->
        <path d="M0 -40 C-14 -10 -22 2 -10 8 C0 12 10 8 10 8 C22 2 14 -10 0 -40Z" fill="#a51f1a" />
        <path d="M-50 26 C-20 50 20 50 50 26 C30 38 -30 38 -50 26Z" fill="#1a0b05" />
        <path d="M-36 30 l6 12 l6 -10 l6 12 l6 -12 l6 12 l6 -12 l6 12 l6 -10 l6 10" fill="#fff8e6" stroke="#fff8e6" stroke-width="1" />
        <!-- Espejitos y adornos -->
        {[-80, -48, 48, 80].map((x, i) => <circle cx={x} cy={i % 3 ? -10 : 10} r="9" fill="url(#g-espejo)" stroke="#f2b632" stroke-width="3" />)}
        <circle cx="0" cy="-118" r="10" fill="url(#g-espejo)" stroke="#f2b632" stroke-width="3" />
