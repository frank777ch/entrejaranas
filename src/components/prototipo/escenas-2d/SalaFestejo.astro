      </radialGradient>
      <radialGradient id="fj-callejon" cx="0.5" cy="0.45" r="0.6">
        <stop offset="0" stop-color="#fff0c8" />
        <stop offset="1" stop-color="#f3b26b" />
      </radialGradient>
      <pattern id="fj-adobe" width="64" height="30" patternUnits="userSpaceOnUse">
        <rect width="64" height="30" fill="#9a5b30" />
        <rect x="2" y="2" width="60" height="12" rx="2" fill="#b06a3a" />
        <rect x="-30" y="16" width="60" height="12" rx="2" fill="#a86334" />
        <rect x="34" y="16" width="60" height="12" rx="2" fill="#b77141" />
      </pattern>
      <pattern id="fj-grano" width="90" height="70" patternUnits="userSpaceOnUse">
        <circle cx="12" cy="18" r="2.5" fill="#6a3418" opacity="0.35" />
        <circle cx="58" cy="9" r="1.8" fill="#fff0d0" opacity="0.25" />
        <circle cx="40" cy="48" r="3" fill="#6a3418" opacity="0.25" />
        <circle cx="78" cy="58" r="1.6" fill="#fff0d0" opacity="0.3" />
        <ellipse cx="22" cy="62" rx="6" ry="2.5" fill="#5a2c12" opacity="0.25" />
      </pattern>
      <clipPath id="fj-clip-callejon"><rect x="70" y="250" width="220" height="490" /></clipPath>
    </defs>

    <!-- Cielo del atardecer sobre el patio -->
    <rect width={W} height="260" fill="url(#fj-cielo)" />

    <!-- Pared de adobe enlucida -->
    <rect y="120" width={W} height={piso - 120} fill="url(#fj-pared)" />
    <rect y="120" width={W} height={piso - 120} fill="url(#fj-grano)" />
    {
      parches.map((p) => (
        <g>
          <path
            d={`M${p.x} ${p.y + p.h * 0.3} C${p.x + p.w * 0.2} ${p.y - 6} ${p.x + p.w * 0.7} ${p.y + 8} ${p.x + p.w} ${p.y + p.h * 0.25} C${p.x + p.w * 1.04} ${p.y + p.h * 0.7} ${p.x + p.w * 0.6} ${p.y + p.h} ${p.x + p.w * 0.3} ${p.y + p.h * 0.9} C${p.x} ${p.y + p.h * 0.85} ${p.x - 8} ${p.y + p.h * 0.6} ${p.x} ${p.y + p.h * 0.3}Z`}
            fill="url(#fj-adobe)"
            stroke="#f2b77c"
            stroke-width="4"
          />
        </g>
      ))
    }
    <!-- Zócalo pintado -->
    <rect y="628" width={W} height={piso - 628} fill="#8e3b1c" />
    <rect y="620" width={W} height="10" fill="#f2c27a" />
    <rect y="628" width={W} height={piso - 628} fill="url(#fj-grano)" />

    <!-- Callejón al fondo, por la entrada de la izquierda -->
    <g>
      <rect x="54" y="232" width="252" height="508" fill="#5a2a10" />
      <g clip-path="url(#fj-clip-callejon)">
        <rect x="70" y="250" width="220" height="490" fill="url(#fj-callejon)" />
        <polygon points="70,250 150,420 150,600 70,740" fill="#c26a35" />
        <polygon points="290,250 210,420 210,600 290,740" fill="#a95529" />
        <polygon points="70,740 150,600 210,600 290,740" fill="#8a4a22" />
        <polygon points="150,600 210,600 230,630 130,630" fill="#9b5a2c" opacity="0.6" />
