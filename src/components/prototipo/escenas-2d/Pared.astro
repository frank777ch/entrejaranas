---
// Vista frontal de una pared de la casona: techo con vigas, paredes laterales,
// pared de frente con cornisa y zócalo de azulejos, y piso en damero.
// Lo que va sobre la pared (arcos, cuadros, muebles) entra por el slot.
import { ANCHO, ALTO, FUGA, PARED, caja, damero, haciaFuga, pts } from './geometria';

interface Props {
  vista: string;
}

const { vista } = Astro.props;
const c = caja();
const piso = damero(24);
const { x0, x1, y0, y1 } = PARED;
const zocalo = 640;

const vigas = Array.from({ length: 11 }, (_, i) => {
  const x = x0 + ((x1 - x0) * (i + 0.5)) / 11;
  const lejos = (dx: number) => FUGA.x + (x + dx - FUGA.x) * ((0 - FUGA.y) / (y0 - FUGA.y));
  return pts([
    [x - 9, y0],
    [x + 9, y0],
    [lejos(9), 0],
    [lejos(-9), 0],
  ]);
});

const lateral = (x: number, borde: number, ya: number, yb: number) =>
  pts([
    [borde, haciaFuga(x, ya, borde)],
    [x, ya],
    [x, yb],
    [borde, haciaFuga(x, yb, borde)],
  ]);
---

<svg viewBox={`0 0 ${ANCHO} ${ALTO}`} width={ANCHO} height={ALTO} class="lamina" data-vista={vista}>
  <!-- Techo -->
  <polygon points={c.techo} fill="url(#g-techo)" />
  {vigas.map((p) => <polygon points={p} fill="#2c1607" opacity="0.85" />)}

  <!-- Paredes laterales -->
  <polygon points={c.izquierda} fill="url(#g-pared-lat-izq)" />
  <polygon points={c.derecha} fill="url(#g-pared-lat-der)" />
  <polygon points={lateral(x0, 0, zocalo, y1)} fill="url(#p-azulejo)" opacity="0.8" />
  <polygon points={lateral(x1, ANCHO, zocalo, y1)} fill="url(#p-azulejo)" opacity="0.8" />
  <polygon points={lateral(x0, 0, zocalo, y1)} fill="#3a1a08" opacity="0.35" />
  <polygon points={lateral(x1, ANCHO, zocalo, y1)} fill="#3a1a08" opacity="0.35" />
  <polygon points={lateral(x0, 0, y0, y0 + 30)} fill="url(#g-madera)" />
  <polygon points={lateral(x1, ANCHO, y0, y0 + 30)} fill="url(#g-madera)" />

  <!-- Pared de frente -->
  <rect x={x0} y={y0} width={x1 - x0} height={y1 - y0} fill="url(#g-pared)" />
  <rect x={x0} y={zocalo} width={x1 - x0} height={y1 - zocalo} fill="url(#p-azulejo)" />
  <rect x={x0} y={zocalo} width={x1 - x0} height={y1 - zocalo} fill="url(#g-zocalo)" />
  <rect x={x0} y={zocalo - 12} width={x1 - x0} height="12" fill="url(#g-madera)" />
  <rect x={x0} y={zocalo - 14} width={x1 - x0} height="3" fill="#f3d58f" opacity="0.6" />

  <!-- Cornisa -->
  <rect x={x0} y={y0} width={x1 - x0} height="30" fill="url(#g-madera)" />
  <rect x={x0} y={y0 + 30} width={x1 - x0} height="8" fill="#f2dcae" />
  <rect x={x0} y={y0 + 38} width={x1 - x0} height="4" fill="#b88c55" />
  <path
    d={`M${x0} ${y0 + 42} ${Array.from({ length: 46 }, () => `h15 v8 h15 v-8`).join(' ')}`}
    fill="none"
    stroke="#c49a62"
    stroke-width="3"
    opacity="0.7"
  />

  <!-- Piso -->
  <polygon points={c.piso} fill="#e8dcc0" />
  {piso.oscuras.map((p) => <polygon points={p} fill="#3a2414" />)}
  {piso.claras.map((p) => <polygon points={p} fill="#efe4cc" />)}
  <polygon points={c.piso} fill="url(#g-piso-sombra)" />
  <rect x={x0} y={y1} width={x1 - x0} height="5" fill="#2a1406" opacity="0.6" />

  <slot />

  <!-- Luz y viñeta -->
  <rect width={ANCHO} height={ALTO} fill="url(#g-luz)" pointer-events="none" />
  <rect width={ANCHO} height={ALTO} fill="url(#g-vineta)" pointer-events="none" />
</svg>
