---
// Sala principal: el patio-salón de la casona, con sus cuatro paredes, el techo y el piso.
// frente: vals · derecha: polka y festejo · fondo: balcón, gramófono y espejo · izquierda: tondero y marinera
import { casona, generos, type GeneroId } from '../../../data/museo-prototipo';
import Pared from './Pared.astro';
import Arco from './Arco.astro';
import Aplique from './Aplique.astro';
import Maceta from './Maceta.astro';
import Cuadro from './Cuadro.astro';
import Lampara from './Lampara.astro';
import Gramofono from './Gramofono.astro';
import Espejo from './Espejo.astro';
import Interactivo from './Interactivo.astro';

const g = (id: GeneroId) => generos.find((x) => x.id === id)!;
const objeto = (id: string) => casona.objetos.find((o) => o.id === id)!;
const piso = 712;

// Banderines de la guirnalda de la polka
const banderines = Array.from({ length: 13 }, (_, i) => {
  const t = i / 12;
  const x = 350 + t * 340;
  const y = 150 + Math.sin(t * Math.PI * 2) ** 2 * 26;
  return { x, y, color: ['#e5b23c', '#a24b78', '#f3e6cc', '#2f8a7a'][i % 4] };
});

// Casetones del techo
const casetones = Array.from({ length: 24 }, (_, i) => ({ c: i % 6, f: Math.floor(i / 6) }));
---

<!-- FRENTE -->
<div class="vista-2d" data-vista="frente" data-ancho="1600">
  <Pared vista="frente">
    <Cuadro x={210} y={225} ancho={186} alto={124} imagen="/museo/texturas/cuadro-plaza.webp" />
    <Cuadro x={1204} y={225} ancho={186} alto={124}>
      <rect x="1204" y="225" width="186" height="124" fill="url(#g-cielo)" />
      <path d="M1204 300 Q1250 270 1300 292 T1390 284 V349 H1204Z" fill="#6b7f6a" />
      <path d="M1204 318 H1390 V349 H1204Z" fill="#3f6c8c" />
      <path d="M1210 322 h40 M1280 330 h50 M1340 324 h30" stroke="#d7e7f0" stroke-width="2" />
      <path d="M1236 300 l10 -24 l10 24z M1240 292 h12" fill="#6b4a2a" stroke="#6b4a2a" />
    </Cuadro>
    <Aplique x={470} y={360} />
    <Aplique x={1130} y={360} />
    <Arco genero={g('vals')} cx={800} ancho={400} alto={520}>
      <g transform="translate(800 720) scale(1.25) translate(-1080 -720)">
        <rect x="1026" y="420" width="108" height="140" fill="#14203b" />
        <circle cx="1106" cy="448" r="12" fill="#f6efd0" />
        <path d="M1026 560 V520 h14 v-16 h12 v24 h10 v-36 h16 v28 h12 v-20 h14 v30 h10 v-12 h24 V560Z" fill="#0b1426" />
        <g fill="#f6c95a">
          <rect x="1044" y="526" width="3" height="4" />
          <rect x="1068" y="512" width="3" height="4" />
          <rect x="1096" y="532" width="3" height="4" />
        </g>
        <rect x="1026" y="420" width="108" height="140" fill="none" stroke="#3a2a1a" stroke-width="8" />
        <circle cx="1124" cy="590" r="40" fill="url(#g-halo)" />
        <path d="M1124 640 v-44" stroke="#1a1a1a" stroke-width="4" />
        <rect x="1116" y="580" width="16" height="18" fill="#ffd77a" stroke="#1a1a1a" stroke-width="2" />
      </g>
    </Arco>
    <Maceta x={548} y={piso} escala={0.8} />
    <Maceta x={1052} y={piso} escala={0.8} />
  </Pared>
</div>

<!-- DERECHA -->
<div class="vista-2d" data-vista="derecha" data-ancho="1600">
  <Pared vista="derecha">
    <Arco genero={g('polka')} cx={520} ancho={300} alto={430}>
      <path d="M448 440 Q484 470 520 440 T592 440" fill="none" stroke="#f6e2b0" stroke-width="3" />
      <path d="M448 480 Q484 510 520 480 T592 480" fill="none" stroke="#f6e2b0" stroke-width="3" />
      {[456, 476, 496, 520, 544, 564, 584].map((x, i) => (
        <path d={`M${x} ${448 + Math.abs(Math.sin(i)) * 10} l7 16 l7 -16z`} fill={['#e5b23c', '#f3e6cc', '#2f8a7a'][i % 3]} />
      ))}
      <ellipse cx="520" cy="620" rx="60" ry="12" fill="#f3d9e6" opacity="0.35" />
      <circle cx="560" cy="590" r="7" fill="#f3e6cc" opacity="0.7" />
      <path d="M478 640 c4 -40 10 -60 14 -70 c6 10 10 30 12 70z" fill="#5c1f3e" opacity="0.8" />
    </Arco>
    <!-- Guirnalda sobre el arco de la polka -->
    <path d="M350 150 Q435 204 520 150 T690 150" fill="none" stroke="#5a3a18" stroke-width="3" />
    {banderines.map((b) => <path d={`M${b.x - 11} ${b.y} h22 l-11 26z`} fill={b.color} stroke="#5a3a18" stroke-width="1.5" />)}
    <Aplique x={800} y={380} escala={0.85} />
    <Maceta x={800} y={piso} escala={0.62} />
    <Arco genero={g('festejo')} cx={1080} ancho={300} alto={430}>
      <g stroke="#7a3412" stroke-width="2" opacity="0.5">
        {[440, 470, 500, 530, 560, 590].map((y, i) => (
          <path d={`M1008 ${y} H1152 ${Array.from({ length: 5 }, (_, j) => `M${1018 + j * 30 + (i % 2) * 15} ${y} v30`).join(' ')}`} />
        ))}
      </g>
      <!-- Máscara festiva con flecos -->
      <g transform="translate(1080 482)">
        {[-30, -18, -6, 6, 18, 30].map((x, i) => (
          <path d={`M${x} 26 q${i % 2 ? 4 : -4} 22 0 40`} stroke={['#e5b23c', '#2f8a7a', '#c0303a'][i % 3]} stroke-width="5" fill="none" stroke-linecap="round" />
        ))}
        <path d="M0 -44 C26 -44 34 -20 32 4 C30 28 16 40 0 42 C-16 40 -30 28 -32 4 C-34 -20 -26 -44 0 -44Z" fill="#1d1d1d" stroke="#e5b23c" stroke-width="3" />
        <path d="M-32 -6 H32 M-30 14 H30" stroke="#c0303a" stroke-width="4" />
        <path d="M-20 -18 q8 -8 16 0 q-8 6 -16 0Z M4 -18 q8 -8 16 0 q-8 6 -16 0Z" fill="#f3e6cc" />
        <path d="M-10 26 q10 6 20 0" stroke="#f3e6cc" stroke-width="3" fill="none" />
        <path d="M0 -4 v16" stroke="#e5b23c" stroke-width="3" />
        <circle cx="0" cy="-34" r="4" fill="#2f8a7a" />
        <path d="M-22 -40 l-10 -16 M22 -40 l10 -16 M0 -44 v-18" stroke="#e5b23c" stroke-width="4" stroke-linecap="round" />
      </g>
      <rect x="1036" y="586" width="44" height="54" fill="url(#g-madera)" stroke="#3a1d08" stroke-width="2" />
      <circle cx="1058" cy="608" r="7" fill="#2a1406" />
    </Arco>
    <!-- Cajón junto al festejo -->
    <g transform="translate(1316 712)" filter="url(#f-sombra)">
      <path d="M-50 -150 h100 l18 -18 h-100z" fill="#b5743c" />
      <path d="M50 -150 l18 -18 v150 l-18 18z" fill="#6e3e18" />
      <rect x="-50" y="-150" width="100" height="150" fill="url(#g-madera-h)" stroke="#3a1d08" stroke-width="2" />
      <circle cx="0" cy="-60" r="18" fill="#2a1406" />
      <rect x="-50" y="-150" width="100" height="150" fill="none" stroke="#e5b23c" stroke-width="3" opacity="0.35" />
    </g>
  </Pared>
</div>

<!-- FONDO -->
<div class="vista-2d" data-vista="fondo" data-ancho="1600">
  <Pared vista="fondo">
    <!-- Balcón de cajón visto desde dentro -->
    <g filter="url(#f-sombra)">
      <rect x="470" y="150" width="660" height="570" fill="url(#g-madera-osc)" />
    </g>
    <rect x="500" y="180" width="600" height="320" fill="url(#g-cielo)" />
    <path d="M500 420 L560 390 L640 410 L720 370 L800 400 L880 360 L960 395 L1040 372 L1100 392 V500 H500Z" fill="#b9a586" opacity="0.7" />
    <path d="M500 460 h600 v40 h-600z" fill="#9e8a6c" opacity="0.6" />
    <rect x="500" y="180" width="160" height="320" fill="url(#p-celosia)" />
    <rect x="940" y="180" width="160" height="320" fill="url(#p-celosia)" />
    <rect x="660" y="180" width="280" height="320" fill="none" stroke="#3a1d08" stroke-width="10" />
    <path d="M800 180 v320 M660 340 h280" stroke="#3a1d08" stroke-width="6" />
    <rect x="500" y="180" width="600" height="320" fill="none" stroke="#3a1d08" stroke-width="12" />
    <rect x="470" y="150" width="660" height="34" fill="url(#g-madera)" />
    <path d="M470 150 h660 l-20 -26 h-620z" fill="url(#g-madera-osc)" />
    {
      [0, 1, 2, 3].map((i) => (
        <g>
          <rect x={500 + i * 150} y="520" width="150" height="190" fill="url(#g-madera)" stroke="#3a1d08" stroke-width="4" />
          <rect x={518 + i * 150} y="540" width="114" height="150" fill="none" stroke="#c78a4e" stroke-width="3" opacity="0.7" />
          <path d={`M${575 + i * 150} 570 l20 45 l-20 45 l-20 -45z`} fill="#c78a4e" opacity="0.5" />
        </g>
      ))
    }
    <rect x="490" y="500" width="620" height="22" fill="url(#g-madera)" />
    <!-- Rayos de luz -->
    <polygon points="660,190 940,190 1180,900 420,900" fill="url(#g-rayo)" opacity="0.6" pointer-events="none" />

    <Interactivo id="gramofono" nombre={objeto('gramofono').nombre} cx={262} cy={480} alto={420} iy={400}>
      <Gramofono x={262} y={piso} />
    </Interactivo>

    <!-- Consola bajo el espejo -->
    <g transform="translate(1330 712)">
      <ellipse cx="0" cy="4" rx="120" ry="12" fill="#1c0b03" opacity="0.35" />
      <path d="M-90 -160 C-110 -100 -60 -60 -80 0 M90 -160 C110 -100 60 -60 80 0" fill="none" stroke="url(#g-oro)" stroke-width="12" stroke-linecap="round" />
      <rect x="-120" y="-176" width="240" height="22" rx="4" fill="#efe8dc" stroke="#b3a68f" stroke-width="2" />
      <path d="M-100 -154 q100 40 200 0" fill="none" stroke="url(#g-oro)" stroke-width="8" />
      <path d="M-30 -176 c-6 -30 66 -30 60 0z" fill="#3f6c8c" />
      <g fill="#c0303a">
        <circle cx="-14" cy="-214" r="12" />
        <circle cx="10" cy="-222" r="13" />
        <circle cx="26" cy="-204" r="11" />
      </g>
      <path d="M-6 -196 l-10 -30 M4 -196 l8 -36" stroke="#3f6a2a" stroke-width="3" />
    </g>
    <Interactivo id="espejo" nombre={objeto('espejo').nombre} cx={1330} cy={350} alto={360}>
      <Espejo x={1330} y={350} ancho={170} alto={236} />
    </Interactivo>
  </Pared>
</div>

<!-- IZQUIERDA -->
<div class="vista-2d" data-vista="izquierda" data-ancho="1600">
  <Pared vista="izquierda">
    <!-- Sombrero de paja colgado junto al tondero -->
    <g transform="translate(272 410)" filter="url(#f-sombra)">
      <circle cx="0" cy="-34" r="7" fill="url(#g-madera)" />
      <ellipse cx="0" cy="18" rx="70" ry="22" fill="#d9b56a" stroke="#9c7a35" stroke-width="2" />
      <path d="M-36 14 C-38 -30 38 -30 36 14Z" fill="#e3c27a" stroke="#9c7a35" stroke-width="2" />
      <path d="M-37 2 C-20 8 20 8 37 2 L36 12 C20 18 -20 18 -36 12Z" fill="#3a1d08" />
      <path d="M-60 18 h120 M-50 26 h100 M-26 -10 h52" stroke="#b8954a" stroke-width="2" opacity="0.7" />
    </g>
    <Arco genero={g('tondero')} cx={520} ancho={300} alto={430}>
      <rect x="466" y="420" width="108" height="140" fill="url(#g-cielo)" />
      <path d="M466 520 Q500 500 530 512 T574 506 V560 H466Z" fill="#e8c98a" />
      <path d="M492 530 v-36 M492 500 c-30 -4 -34 -30 -10 -36 c6 -20 36 -18 40 0 c22 2 22 30 0 34 c-10 6 -22 6 -30 2z" fill="#4c6b25" stroke="#5a3a18" stroke-width="5" />
      <rect x="466" y="420" width="108" height="140" fill="none" stroke="#7a5228" stroke-width="8" />
      <path d="M520 420 v140 M466 490 h108" stroke="#7a5228" stroke-width="4" />
      <ellipse cx="500" cy="636" rx="34" ry="9" fill="#d9b56a" />
      <path d="M484 634 c0 -16 32 -16 32 0z" fill="#e3c27a" />
    </Arco>
    <Aplique x={800} y={380} escala={0.85} />
    <Maceta x={800} y={piso} escala={0.62} />
    <Arco genero={g('marinera')} cx={1080} ancho={300} alto={430}>
      <g transform="translate(1080 720) scale(0.8) translate(-800 -720)">
        <rect x="704" y="200" width="192" height="434" fill="url(#p-damasco)" opacity="0.55" />
        <Lampara x={800} y={330} escala={0.32} cadena={140} />
        <rect x="822" y="455" width="54" height="74" fill="url(#g-oro-h)" />
        <image href="/prototipos/2d/pareja.webp" x="828" y="461" width="42" height="62" preserveAspectRatio="xMidYMid slice" />
        <image href="/prototipos/2d/vestido.webp" x="712" y="520" width="92" height="120" />
        <rect x="740" y="610" width="120" height="22" rx="4" fill="#6e0f14" opacity="0.6" />
      </g>
    </Arco>
  </Pared>
</div>

<!-- ARRIBA: artesonado y lámpara -->
<div class="vista-2d" data-vista="arriba" data-ancho="1600">
  <svg viewBox="0 0 1600 900" width="1600" height="900" class="lamina" data-vista="arriba">
    <rect width="1600" height="900" fill="url(#g-pared)" />
    <polygon points="0,0 1600,0 1340,150 260,150" fill="#d9b67c" />
    <polygon points="0,900 1600,900 1340,750 260,750" fill="#c79e62" />
    <polygon points="0,0 260,150 260,750 0,900" fill="#b88a50" />
    <polygon points="1600,0 1340,150 1340,750 1600,900" fill="#b88a50" />
    <path d="M0 0 L260 150 M1600 0 L1340 150 M0 900 L260 750 M1600 900 L1340 750" stroke="#8a5a2a" stroke-width="3" />
    <!-- Cornisa alrededor -->
    <rect x="230" y="120" width="1140" height="660" fill="none" stroke="url(#g-madera)" stroke-width="60" />
    <rect x="200" y="90" width="1200" height="720" fill="none" stroke="#f2dcae" stroke-width="6" />
    <!-- Casetones -->
    <rect x="260" y="150" width="1080" height="600" fill="url(#g-techo)" />
    {
      casetones.map(({ c, f }) => {
        const x = 260 + c * 180;
        const y = 150 + f * 150;
        return (
          <g>
            <rect x={x + 10} y={y + 10} width="160" height="130" fill="#4a2a12" />
            <polygon points={`${x + 10},${y + 10} ${x + 170},${y + 10} ${x + 150},${y + 30} ${x + 30},${y + 30}`} fill="#7a4a22" />
            <polygon points={`${x + 10},${y + 10} ${x + 30},${y + 30} ${x + 30},${y + 120} ${x + 10},${y + 140}`} fill="#6a3d1c" />
            <rect x={x + 30} y={y + 30} width="120" height="90" fill="#5a3317" />
            <circle cx={x + 90} cy={y + 75} r="14" fill="url(#g-oro)" />
            <circle cx={x + 90} cy={y + 75} r="6" fill="#8f6418" />
          </g>
        );
      })
    }
    <!-- Lámpara vista desde abajo -->
    <circle cx="800" cy="450" r="330" fill="url(#g-halo)" />
    {
      Array.from({ length: 8 }, (_, i) => {
        const a = (i / 8) * Math.PI * 2;
        const x = 800 + Math.cos(a) * 170;
        const y = 450 + Math.sin(a) * 170;
        return (
          <g>
            <line x1="800" y1="450" x2={x} y2={y} stroke="url(#g-oro)" stroke-width="12" stroke-linecap="round" />
            <circle cx={x} cy={y} r="26" fill="url(#g-oro)" stroke="#7a5212" stroke-width="2" />
            <circle cx={x} cy={y} r="13" fill="#fbf3e0" />
            <circle cx={x} cy={y} r="6" fill="#ffcf5a" />
          </g>
        );
      })
    }
    <circle cx="800" cy="450" r="92" fill="none" stroke="url(#g-oro)" stroke-width="10" />
    <circle cx="800" cy="450" r="52" fill="url(#g-oro)" stroke="#7a5212" stroke-width="3" />
    <circle cx="800" cy="450" r="22" fill="#8f6418" />
    <rect width="1600" height="900" fill="url(#g-vineta)" pointer-events="none" />
  </svg>
</div>

<!-- ABAJO: piso de damero con alfombra -->
<div class="vista-2d" data-vista="abajo" data-ancho="1600">
  <svg viewBox="0 0 1600 900" width="1600" height="900" class="lamina" data-vista="abajo">
    <defs>
      <pattern id="p-damero" width="100" height="100" patternUnits="userSpaceOnUse" x="0" y="0">
        <rect width="100" height="100" fill="#efe4cc" />
        <rect width="50" height="50" fill="#3a2414" />
        <rect x="50" y="50" width="50" height="50" fill="#3a2414" />
      </pattern>
      <pattern id="p-borde-alfombra" width="40" height="40" patternUnits="userSpaceOnUse">
        <rect width="40" height="40" fill="#6e0f14" />
        <path d="M20 4 L36 20 L20 36 L4 20Z" fill="#d9a640" />
        <circle cx="20" cy="20" r="5" fill="#2f5a8a" />
      </pattern>
    </defs>
    <rect width="1600" height="900" fill="url(#p-damero)" />
    <!-- Zócalos de las paredes, hacia los bordes -->
    <polygon points="0,0 1600,0 1480,70 120,70" fill="url(#p-azulejo)" />
    <polygon points="0,900 1600,900 1480,830 120,830" fill="url(#p-azulejo)" />
    <polygon points="0,0 120,70 120,830 0,900" fill="url(#p-azulejo)" />
    <polygon points="1600,0 1480,70 1480,830 1600,900" fill="url(#p-azulejo)" />
    <rect x="0" y="0" width="1600" height="900" fill="none" stroke="#1c0b03" stroke-opacity="0.35" stroke-width="40" />
    <rect x="120" y="70" width="1360" height="760" fill="none" stroke="url(#g-madera)" stroke-width="10" />
    <!-- Alfombra -->
    <g filter="url(#f-sombra)">
      <rect x="430" y="210" width="740" height="480" rx="6" fill="url(#p-borde-alfombra)" />
    </g>
    <rect x="470" y="250" width="660" height="400" fill="#8e1c22" />
    <rect x="490" y="270" width="620" height="360" fill="none" stroke="#d9a640" stroke-width="4" />
    <path d="M800 300 L1000 450 L800 600 L600 450Z" fill="#a32a31" stroke="#d9a640" stroke-width="4" />
    {
      generos.map((ge, i) => {
        const a = (i / 5) * Math.PI * 2 - Math.PI / 2;
        return <circle cx={800 + Math.cos(a) * 70} cy={450 + Math.sin(a) * 70} r="18" fill={ge.color} stroke="#f3d58f" stroke-width="3" />;
      })
    }
    <circle cx="800" cy="450" r="26" fill="#d9a640" />
    <path d="M430 230 h-30 M430 300 h-30 M430 370 h-30 M430 440 h-30 M430 510 h-30 M430 580 h-30 M430 650 h-30 M1170 230 h30 M1170 300 h30 M1170 370 h30 M1170 440 h30 M1170 510 h30 M1170 580 h30 M1170 650 h30" stroke="#f3e6cc" stroke-width="4" />
    <rect width="1600" height="900" fill="url(#g-luz)" pointer-events="none" />
    <rect width="1600" height="900" fill="url(#g-vineta)" pointer-events="none" />
  </svg>
</div>
