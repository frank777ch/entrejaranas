---
// Pañuelo blanco sobre un cojín, en un pedestal con campana de vidrio; (x, y) es la base
interface Props {
  x: number;
  y: number;
  escala?: number;
}

const { x, y, escala = 1 } = Astro.props;
---

<g transform={`translate(${x} ${y}) scale(${escala})`}>
  <ellipse cx="0" cy="4" rx="100" ry="13" fill="#1c0b03" opacity="0.35" />
  <!-- Pedestal -->
  <rect x="-78" y="-28" width="156" height="28" rx="3" fill="url(#g-madera)" />
  <rect x="-58" y="-232" width="116" height="206" fill="url(#g-madera-h)" />
  <rect x="-44" y="-218" width="88" height="178" fill="none" stroke="#d9a640" stroke-width="3" opacity="0.7" />
  <rect x="-80" y="-254" width="160" height="24" rx="3" fill="url(#g-madera)" />
  <rect x="-80" y="-254" width="160" height="5" rx="2" fill="#c78a4e" />
  <!-- Cojín -->
  <path d="M-86 -262 C-90 -290 -60 -296 0 -294 C60 -296 90 -290 86 -262 C80 -250 -80 -250 -86 -262Z" fill="url(#g-terciopelo)" />
  <circle cx="-84" cy="-266" r="7" fill="url(#g-oro)" />
  <circle cx="84" cy="-266" r="7" fill="url(#g-oro)" />
  <!-- Pañuelo con pliegues que caen por delante -->
  <path
    d="M-54 -292 C-30 -306 22 -306 54 -290 C58 -270 50 -246 58 -222 C40 -214 30 -230 18 -212 C6 -228 -8 -210 -22 -226 C-36 -212 -46 -228 -60 -216 C-52 -240 -62 -266 -54 -292Z"
    fill="url(#g-tela)"
    stroke="#c9bfae"
    stroke-width="2"
  />
  <path d="M-30 -296 C-26 -270 -34 -246 -22 -226 M6 -300 C2 -270 10 -244 6 -224 M34 -296 C30 -270 36 -244 32 -220" fill="none" stroke="#cfc6b5" stroke-width="2.5" />
  <path d="M-60 -216 C-46 -228 -36 -212 -22 -226 C-8 -210 6 -228 18 -212 C30 -230 40 -214 58 -222" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="3 4" />
  <!-- Campana de vidrio -->
  <path d="M-96 -256 V-380 C-96 -450 96 -450 96 -380 V-256" fill="#dff0ff" fill-opacity="0.1" stroke="#f6fbff" stroke-opacity="0.55" stroke-width="3" />
  <path d="M-74 -270 V-376 C-74 -414 -40 -428 -20 -430" fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="5" stroke-linecap="round" />
  <circle cx="0" cy="-440" r="9" fill="url(#g-oro)" />
</g>
