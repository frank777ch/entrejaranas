---
const tarjetas = [
  {
    titulo: 'Misión',
    texto:
      'Lograr que el público reconozca que la música criolla continúa vigente a través de las experiencias de los diferentes actores que la preservan.',
    clase: 'vino',
    simbolo: 'M12 3c3 0 5 2 5 5 0 2-1 3-2 4 2 1 3 3 3 5 0 2-2 4-6 4s-6-2-6-4c0-2 1-4 3-5-1-1-2-2-2-4 0-3 2-5 5-5z',
  },
  {
    titulo: 'Visión',
    texto:
      'Ser un proyecto que conecte las historias y experiencias de la música criolla con los públicos juveniles.',
    clase: 'oro',
    simbolo: 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zm10 4a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',
  },
  {
    titulo: 'Valores',
    texto: 'Sentido de pertenencia, innovación, responsabilidad sociocultural, alegría, creatividad y jovialidad.',
    clase: 'cafe',
    simbolo: 'M12 21s-8-5.5-8-11a5 5 0 0 1 8-4 5 5 0 0 1 8 4c0 5.5-8 11-8 11z',
  },
];
---

<section id="proposito" class="seccion proposito">
  <div class="contenedor">
    <div class="proposito__cabeza revelar">
      <p class="antetitulo">Nuestro propósito</p>
      <h2 class="titulo-seccion">Que la jarana <em>no se apague</em></h2>
      <p class="proposito__bajada">Pasa el cursor (o toca) cada tarjeta para descubrirla.</p>
    </div>

    <div class="tarjetas">
      {
        tarjetas.map((t, i) => (
          <article class:list={['tarjeta', `tarjeta--${t.clase}`, 'revelar']} tabindex="0" style={`--i:${i}`}>
            <div class="tarjeta__frente">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={t.simbolo} />
              </svg>
              <h3>{t.titulo}</h3>
            </div>
            <p class="tarjeta__texto">{t.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .proposito {
    background: var(--crema-oscuro);
  }
  .proposito__cabeza {
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .proposito__bajada {
    margin-top: 1rem;
    font-size: 0.95rem;
    opacity: 0.75;
  }

  .tarjetas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: 3rem;
  }
  .tarjeta {
    position: relative;
    min-height: 360px;
    border-radius: 120px 120px var(--radio) var(--radio);
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 2.5rem 2rem;
    text-align: center;
    cursor: pointer;
    outline-offset: 6px;
    transition-delay: calc(var(--i) * 0.12s);
  }
  .tarjeta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/patron.png');
    background-size: 90px;
    opacity: 0.12;
    transition: opacity 0.5s ease;
  }
  .tarjeta--vino {
    background: var(--vino);
    color: var(--crema);
  }
  .tarjeta--oro {
    background: var(--oro);
    color: var(--cafe);
  }
  .tarjeta--cafe {
    background: var(--cafe);
    color: var(--crema);
  }
  .tarjeta--oro::before {
    filter: brightness(0.4);
  }

  .tarjeta__frente,
  .tarjeta__texto {
    grid-area: 1 / 1;
    position: relative;
    transition:
      opacity 0.5s ease,
      filter 0.5s ease,
      transform 0.5s ease;
  }
  .tarjeta__frente svg {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    fill: currentColor;
    opacity: 0.9;
  }
  .tarjeta h3 {
    color: inherit;
    font-size: clamp(2rem, 3.5vw, 2.6rem);
  }
  .tarjeta__texto {
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(14px);
  }

  /* Al acercar el cursor el frente se difumina y aparece el texto */
  .tarjeta:hover .tarjeta__frente,
  .tarjeta:focus-visible .tarjeta__frente {
    opacity: 0;
    filter: blur(10px);
    transform: scale(0.9);
  }
  .tarjeta:hover .tarjeta__texto,
  .tarjeta:focus-visible .tarjeta__texto {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .tarjeta:hover::before {
    opacity: 0.05;
  }

  /* En pantallas táctiles o angostas se muestran ambos */
  @media (hover: none), (max-width: 860px) {
    .tarjeta {
      min-height: 0;
      place-items: initial;
      align-content: center;
      gap: 1rem;
    }
    .tarjeta__frente,
    .tarjeta__texto {
      grid-area: auto;
    }
    .tarjeta__texto,
    .tarjeta:hover .tarjeta__texto {
      opacity: 1;
      filter: none;
      transform: none;
    }
    .tarjeta:hover .tarjeta__frente {
      opacity: 1;
      filter: none;
      transform: none;
    }
    .proposito__bajada {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .tarjetas {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
    }
  }
</style>
