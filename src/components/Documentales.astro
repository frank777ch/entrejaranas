---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Video from './Video.astro';

const documentales = (await getCollection('documentales')).sort((a, b) => a.data.orden - b.data.orden);
const fondos = ['vino', 'oro', 'cafe', 'teja'];
---

<section id="experiencias" class="seccion">
  <div class="contenedor">
    <div class="cabeza revelar">
      <div>
        <p class="antetitulo">Experiencias</p>
        <h2 class="titulo-seccion">Microdocumentales <em>de la jarana</em></h2>
      </div>
      <p class="cabeza__bajada">
        Historias cortas de quienes mantienen viva la música criolla: sus instrumentos, sus barrios y sus voces.
      </p>
    </div>

    <ol class="lista">
      {
        documentales.map((d, i) => (
          <li id={`documental-${d.id}`} class:list={['doc', 'revelar', { 'doc--inv': i % 2 === 1 }]}>
            <div class:list={['doc__medio', `doc__medio--${fondos[i % fondos.length]}`]}>
              {d.data.video ? (
                <Video url={d.data.video} titulo={d.data.titulo} />
              ) : d.data.imagen ? (
                <Image
                  src={d.data.imagen}
                  alt={`Portada: ${d.data.subtitulo ?? d.data.titulo}`}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 820px) calc(100vw - 2rem), 620px"
                />
              ) : (
                <div class="doc__pronto" aria-hidden="true">
                  <span class="doc__play">
                    <svg viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                  <span>Próximamente</span>
                </div>
              )}
            </div>
            <div class="doc__texto">
              <span class="doc__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{d.data.titulo}</h3>
              {d.data.subtitulo && <p class="doc__sub">{d.data.subtitulo}</p>}
              <p>{d.data.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .cabeza__bajada {
    font-size: 1.1rem;
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
  }
  .doc {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .doc--inv .doc__medio {
    order: 2;
  }

  .doc__medio {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
    transform: rotate(-1.5deg);
    transition: transform 0.4s ease;
  }
  .doc--inv .doc__medio {
    transform: rotate(1.5deg);
  }
  .doc:hover .doc__medio {
    transform: rotate(0);
  }
  .doc__medio img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .doc__medio--vino {
    background: var(--vino);
  }
  .doc__medio--oro {
    background: var(--oro);
  }
  .doc__medio--cafe {
    background: var(--cafe);
  }
  .doc__medio--teja {
    background: var(--teja);
  }
  .doc__medio::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/patron.png');
    background-size: 100px;
    opacity: 0.15;
    filter: brightness(2.5) saturate(0);
    pointer-events: none;
  }

  .doc__pronto {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    color: var(--crema);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .doc__medio--oro .doc__pronto {
    color: var(--cafe);
  }
  .doc__play {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--crema);
    transition: transform 0.3s ease;
  }
  .doc:hover .doc__play {
    transform: scale(1.1);
  }
  .doc__play svg {
    width: 34px;
    fill: var(--vino);
    margin-left: 4px;
  }

  .doc__num {
    display: block;
    font-family: var(--f-titulo);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--vino);
    margin-bottom: 0.5rem;
  }
  .doc h3 {
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    margin-bottom: 1rem;
  }
  .doc__sub {
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--vino);
    margin-bottom: 0.75rem;
  }
  .doc p {
    max-width: 44ch;
  }

  @media (max-width: 820px) {
    .cabeza,
    .doc {
      grid-template-columns: 1fr;
    }
    .doc--inv .doc__medio {
      order: 0;
    }
  }
</style>
