---
// Convierte un enlace de YouTube, Vimeo o Cloudflare Stream en un video incrustado.
// Un enlace directo a un .mp4 se reproduce con el reproductor del navegador.
// `portada` se muestra antes de dar play (Cloudflare Stream y .mp4; YouTube y Vimeo usan la suya).
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  url: string;
  titulo: string;
  portada?: ImageMetadata;
}

const { url, titulo, portada } = Astro.props;

function aEmbed(enlace: string): string | null {
  const u = new URL(enlace);
  const host = u.hostname.replace('www.', '');
  if (host === 'youtu.be') return `https://www.youtube-nocookie.com/embed/${u.pathname.slice(1)}`;
  if (host.endsWith('youtube.com')) {
    const id = u.searchParams.get('v') ?? u.pathname.split('/').pop();
    return `https://www.youtube-nocookie.com/embed/${id}`;
  }
  if (host.endsWith('vimeo.com')) return `https://player.vimeo.com/video/${u.pathname.split('/').pop()}`;
  // Cloudflare Stream: sirve el enlace "Watch" (…/<uid>/watch), el del iframe (…/<uid>/iframe)
  // o el corto https://iframe.videodelivery.net/<uid>
  if (host.endsWith('cloudflarestream.com')) {
    const uid = u.pathname.split('/').filter(Boolean)[0];
    return `https://${u.hostname}/${uid}/iframe`;
  }
  if (host === 'iframe.videodelivery.net' || host === 'watch.videodelivery.net') {
    return `https://iframe.videodelivery.net/${u.pathname.split('/').filter(Boolean)[0]}`;
  }
  return null;
}

const embedBase = aEmbed(url);
const directo = !embedBase && /\.(mp4|webm)(\?|$)/i.test(url);

// El reproductor de Stream pide la portada como URL absoluta en ?poster=.
// En una vista previa de Cloudflare Pages (rama distinta de main) la portada se busca en ese mismo
// despliegue (CF_PAGES_URL), porque en producción todavía no existe; si no, en `site`.
const env = (globalThis as { process?: { env: Record<string, string | undefined> } }).process?.env ?? {};
const base = env.CF_PAGES_URL && env.CF_PAGES_BRANCH && env.CF_PAGES_BRANCH !== 'main' ? env.CF_PAGES_URL : Astro.url;
const poster = portada
  ? new URL((await getImage({ src: portada, width: 1280, format: 'jpg' })).src, base).href
  : undefined;
const esStream = !!embedBase && /cloudflarestream\.com|videodelivery\.net/.test(embedBase);
const embed = embedBase && poster && esStream ? `${embedBase}?poster=${encodeURIComponent(poster)}` : embedBase;
---

{
  directo ? (
    <video src={url} title={titulo} poster={poster} controls preload="metadata" playsinline />
  ) : embed ? (
    <iframe
      src={embed}
      title={titulo}
      loading="lazy"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    />
  ) : (
    <a href={url} target="_blank" rel="noopener">
      Ver video
    </a>
  )
}

<style>
  iframe,
  video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  video {
    object-fit: cover;
    background: #000;
  }
</style>
