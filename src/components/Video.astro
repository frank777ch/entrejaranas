---
// Convierte un enlace de YouTube, Vimeo o Cloudflare Stream en un video incrustado.
// Un enlace directo a un .mp4 se reproduce con el reproductor del navegador.
interface Props {
  url: string;
  titulo: string;
}

const { url, titulo } = Astro.props;

function aEmbed(enlace: string): string | null {
  const u = new URL(enlace);
  const host = u.hostname.replace('www.', '');
  if (host === 'youtu.be') return `https://www.youtube-nocookie.com/embed/${u.pathname.slice(1)}`;
  if (host.endsWith('youtube.com')) {
    const id = u.searchParams.get('v') ?? u.pathname.split('/').pop();
    return `https://www.youtube-nocookie.com/embed/${id}`;
  }
  if (host.endsWith('vimeo.com')) return `https://player.vimeo.com/video/${u.pathname.split('/').pop()}`;
  // Cloudflare Stream: sirve el enlace "Watch" (…/<uid>/watch), el del iframe (…/<uid>/iframe)
  // o el corto https://iframe.videodelivery.net/<uid>
  if (host.endsWith('cloudflarestream.com')) {
    const uid = u.pathname.split('/').filter(Boolean)[0];
    return `https://${u.hostname}/${uid}/iframe`;
  }
  if (host === 'iframe.videodelivery.net' || host === 'watch.videodelivery.net') {
    return `https://iframe.videodelivery.net/${u.pathname.split('/').filter(Boolean)[0]}`;
  }
  return null;
}

const embed = aEmbed(url);
const directo = !embed && /\.(mp4|webm)(\?|$)/i.test(url);
---

{
  directo ? (
    <video src={url} title={titulo} controls preload="metadata" playsinline />
  ) : embed ? (
    <iframe
      src={embed}
      title={titulo}
      loading="lazy"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    />
  ) : (
    <a href={url} target="_blank" rel="noopener">
      Ver video
    </a>
  )
}

<style>
  iframe,
  video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  video {
    object-fit: cover;
    background: #000;
  }
</style>
