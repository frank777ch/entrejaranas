---
import Prototipo from '../../layouts/Prototipo.astro';

// Propuesta vigente: la síntesis de A y B pedida en la reunión del 18 de octubre
const propuesta = {
  letra: 'C',
  nombre: 'Cámara fija',
  lema: 'Síntesis de A y B · propuesta actual',
  href: '/prototipos/museo-c',
  imagen: '/prototipos/portada-c.webp',
  texto:
    'Se juega como una novela visual (prototipo A) y se ve con la profundidad del 3D (prototipo B). La cámara no gira libre: sigue al mouse dentro del cuadro y, al elegir una pieza, se acerca y abre su ficha.',
  puntos: [
    'Sala principal con los cinco arcos a la vista: se mira a los costados y arriba',
    'En cada sala, las cinco piezas juntas; la cámara solo se mueve a los lados',
    'Ficha con “Pieza 1 de 5” y flechas para pasar a la siguiente',
    'Lista para cambiar los renders por las ilustraciones del equipo de diseño (JPG)',
  ],
};

const opciones = [
  {
    letra: 'A',
    nombre: '2D ilustrado',
    lema: 'Como una novela visual',
    href: '/prototipos/museo-2d',
    imagen: '/prototipos/portada-2d.webp',
    texto:
      'Escenas dibujadas con fondos detallados. La cámara cambia de plano con fundidos y acercamientos, tal como describe la propuesta.',
    puntos: ['La más liviana: carga al instante en cualquier celular', 'Estilo cálido y cercano, como un libro ilustrado', 'Requiere ilustrar cada ambiente'],
  },
  {
    letra: 'B',
    nombre: 'Vista 3D · 360°',
    lema: 'Se ve 3D, pesa como una imagen',
    href: '/prototipos/museo-360',
    imagen: '/prototipos/portada-360.webp',
    texto:
      'Cada sala se modela en 3D y se convierte en una imagen panorámica. El visitante gira la mirada arrastrando o con las flechas, sin caminar.',
    puntos: ['Sensación de estar dentro de la casona', 'Liviana: una imagen por sala, sin motor 3D', 'Reutiliza los modelos 3D que ya existen'],
  },
];
---

<Prototipo titulo="Prototipos del museo virtual">
  <main class="hub">
    <header class="hub__cabecera">
      <img src="/museo/texturas/logo-mi-museo-criollo.webp" alt="Mi museo criollo" width="1073" height="367" class="hub__logo" />
      <p class="hub__ante">Rediseño del museo virtual · Prototipos</p>
      <h1>Recorrer la casona con cámara fija</h1>
      <p class="hub__intro">
        Una casona limeña con una sala principal y cinco salas, una por género: <strong>vals criollo, marinera limeña, tondero, polka y festejo</strong>.
        Cada sala reúne cinco piezas, con su ficha y su música.
      </p>
    </header>

    <a class="opcion opcion--destacada" href={propuesta.href}>
      <div class="opcion__imagen">
        <img src={propuesta.imagen} alt="" width="1280" height="720" />
        <span class="opcion__letra">{propuesta.letra}</span>
      </div>
      <div class="opcion__cuerpo">
        <p class="opcion__lema">{propuesta.lema}</p>
        <h2>{propuesta.nombre}</h2>
        <p>{propuesta.texto}</p>
        <ul>
          {propuesta.puntos.map((p) => <li>{p}</li>)}
        </ul>
        <span class="boton boton--oro opcion__boton">Abrir prototipo C</span>
      </div>
    </a>

    <h2 class="hub__anteriores">Prototipos anteriores, como referencia</h2>
    <div class="hub__opciones">
      {
        opciones.map((o) => (
          <a class="opcion" href={o.href}>
            <div class="opcion__imagen">
              <img src={o.imagen} alt="" width="1280" height="720" loading="lazy" />
              <span class="opcion__letra">{o.letra}</span>
            </div>
            <div class="opcion__cuerpo">
              <p class="opcion__lema">{o.lema}</p>
              <h2>{o.nombre}</h2>
              <p>{o.texto}</p>
              <ul>
                {o.puntos.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <span class="boton boton--oro opcion__boton">Abrir prototipo {o.letra}</span>
            </div>
          </a>
        ))
      }
    </div>

    <section class="hub__nota">
      <h2>Cómo probarlo</h2>
      <ul>
        <li><strong>Mirar:</strong> en el prototipo C, mueve el mouse (en celular, desliza); también hay flechas en los bordes y en el teclado.</li>
        <li><strong>Asomarse a una sala:</strong> toca un arco. Tócalo otra vez para entrar. En el prototipo C ya está lista la sala 1, vals criollo.</li>
        <li><strong>Conocer una pieza:</strong> tócala para acercarte y ver su ficha; las flechas de la ficha pasan a la siguiente.</li>
        <li><strong>Volver:</strong> la × cierra la ficha; el botón inferior izquierdo regresa a la sala principal.</li>
        <li><strong>Sonido:</strong> la música empieza con el primer toque; el botón de arriba a la derecha la silencia.</li>
      </ul>
      <p>
        Funciona en computadora y celular. La música es original y de muestra, compuesta para el prototipo en el ritmo de cada género; los textos
        también son de muestra. La versión final llevará grabaciones con permiso y contenidos validados con fuentes.
      </p>
    </section>
  </main>
</Prototipo>

<style>
  :global(body.cuerpo-proto) {
    overflow: auto;
    background: radial-gradient(circle at 50% 0%, #4a2112, #1c0d07 60%) fixed;
  }

  .hub {
    max-width: 68rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) var(--gutter) 4rem;
  }

  .hub__cabecera {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto;
  }

  .hub__logo {
    width: min(15rem, 60vw);
    height: auto;
    margin: 0 auto 1.5rem;
  }

  .hub__ante {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--oro);
  }

  h1 {
    margin: 0.4rem 0 0.8rem;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1.15;
    color: var(--crema);
  }

  .hub__intro {
    margin: 0;
    color: rgb(240 231 216 / 0.85);
  }

  .opcion--destacada {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 56rem) {
    .opcion.opcion--destacada {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
    }

    .opcion--destacada .opcion__imagen {
      aspect-ratio: auto;
      min-height: 22rem;
    }
  }

  .hub__anteriores {
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    font-size: 1.15rem;
    color: rgb(240 231 216 / 0.8);
  }

  .hub__opciones {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
  }

  .opcion {
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    background: #f6efe2;
    color: var(--tinta);
    text-decoration: none;
    box-shadow: 0 24px 50px -24px rgb(0 0 0 / 0.8);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }

  .opcion:hover,
  .opcion:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.9);
  }

  .opcion__imagen {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #3a1a0d;
  }

  .opcion__imagen img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .opcion__letra {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--vino);
    color: var(--crema);
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 1.2rem;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.4);
  }

  .opcion__cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .opcion__lema {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--teja);
  }

  .opcion h2 {
    margin: 0.2rem 0 0.5rem;
    font-size: 1.6rem;
    color: var(--cafe);
  }

  .opcion p {
    margin: 0;
    font-size: 0.97rem;
  }

  .opcion ul {
    margin: 0.9rem 0 1.4rem;
    padding-left: 1.1rem;
    font-size: 0.93rem;
  }

  .opcion li + li {
    margin-top: 0.25rem;
  }

  .opcion__boton {
    margin-top: auto;
    align-self: flex-start;
  }

  .hub__nota {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 20px;
    background: rgb(240 231 216 / 0.06);
    border: 1px solid rgb(240 231 216 / 0.14);
    color: rgb(240 231 216 / 0.88);
  }

  .hub__nota h2 {
    margin: 0 0 0.6rem;
    font-size: 1.2rem;
    color: var(--crema);
  }

  .hub__nota ul {
    margin: 0 0 0.8rem;
    padding-left: 1.1rem;
  }

  .hub__nota p {
    margin: 0;
    font-size: 0.92rem;
    color: rgb(240 231 216 / 0.7);
  }
</style>
