---
// Prototipo A: museo en 2D ilustrado, al estilo de una novela visual
import Prototipo from '../../layouts/Prototipo.astro';
import Interfaz from '../../components/prototipo/Interfaz.astro';
import Defs from '../../components/prototipo/escenas-2d/Defs.astro';
import Casona from '../../components/prototipo/escenas-2d/Casona.astro';
import SalaMarinera from '../../components/prototipo/escenas-2d/SalaMarinera.astro';
---

<Prototipo titulo="Prototipo A · Museo 2D ilustrado">
  <Interfaz etiqueta="Prototipo A · 2D ilustrado">
    <Defs />
    <div class="mundo-2d" aria-label="Casona limeña ilustrada">
      <Casona />
      <SalaMarinera />
    </div>
  </Interfaz>
</Prototipo>

<style is:global>
  .defs-2d {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .mundo-2d {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 40%, #3a1a0c, #140703 75%);
    touch-action: none;
  }

  .mundo-2d.arrastrando {
    cursor: grabbing;
  }

  .vista-2d {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
    transition:
      opacity 0.6s ease,
      transform 0.9s cubic-bezier(0.45, 0.05, 0.2, 1),
      visibility 0s linear 0.6s;
  }

  .vista-2d.activa {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.6s ease,
      transform 0.9s cubic-bezier(0.45, 0.05, 0.2, 1),
      visibility 0s;
  }

  .vista-2d.sin-trans,
  .mundo-2d.sin-anim .vista-2d,
  .mundo-2d.arrastrando .vista-2d {
    transition: none !important;
  }

  .lamina {
    display: block;
    overflow: hidden;
  }

  .interactivo {
    cursor: pointer;
    outline: none;
    transition: filter 0.25s;
  }

  .interactivo:hover,
  .interactivo:focus-visible,
  .objeto-2d.abierto {
    filter: url(#f-brillo);
  }

  /* Indicadores visibles solo en pantallas táctiles */
  .indicador {
    display: none;
    pointer-events: none;
  }

  .es-tactil .indicador {
    display: inline;
  }

  .proto[data-modo='asomo'] .indicador,
  .proto.con-ficha .indicador {
    display: none;
  }

  .indicador__onda {
    fill: rgb(255 255 255 / 0.45);
    transform-box: fill-box;
    transform-origin: center;
    animation: onda-2d 2.2s ease-out infinite;
  }

  .indicador__aro {
    fill: rgb(147 23 30 / 0.65);
    stroke: #fff;
    stroke-width: 3;
  }

  .indicador__centro {
    fill: #fff;
  }

  .visto .indicador__centro {
    fill: var(--oro);
  }

  @keyframes onda-2d {
    from {
      transform: scale(0.7);
      opacity: 1;
    }
    to {
      transform: scale(2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vista-2d,
    .vista-2d.activa {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  import '../../scripts/prototipo/motor-2d';
</script>
