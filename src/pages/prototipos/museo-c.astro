---
// Prototipo C: síntesis de A y B pedida en la reunión del 18 de octubre.
// Cámara fija de novela visual sobre tomas ilustradas (herramientas/fija-ilustrada).
import Prototipo from '../../layouts/Prototipo.astro';
import Interfaz from '../../components/prototipo/Interfaz.astro';
---

<Prototipo titulo="Museo · Prototipo C">
  <link rel="preload" href="/prototipos/fija/casona.json" as="fetch" crossorigin="anonymous" />
  <link rel="preload" href="/prototipos/fija/casona-1774.webp" as="fetch" crossorigin="anonymous" />
  <Interfaz etiqueta="Prototipo C · Cámara fija" clase="proto--fija">
    <canvas class="visor-360" role="img" aria-label="Sala principal de la casona limeña. Mueve el mouse o desliza para mirar; elige un arco o una pieza."></canvas>
    <div class="puntos-360"></div>
  </Interfaz>
</Prototipo>

<style is:global>
  .visor-360 {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .es-tactil .visor-360 {
    cursor: grab;
  }

  .puntos-360 {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .puntos-360 .punto {
    pointer-events: auto;
    will-change: transform;
  }

  .puntos-360--ocultos {
    opacity: 0;
  }

  .puntos-360--ocultos .punto {
    pointer-events: none;
  }

  /* Ficha como en el boceto del equipo: panel granate con letras crema y doradas */
  .proto--fija .ficha {
    background: linear-gradient(160deg, #5a0f16, #2e070b 85%);
    color: #f3e6cf;
    border: 1px solid rgb(254 173 21 / 0.35);
    box-shadow:
      inset 0 0 0 6px rgb(46 7 11 / 0.6),
      inset 0 0 0 7px rgb(254 173 21 / 0.25),
      var(--sombra-flotante);
  }

  .proto--fija .ficha__cerrar {
    background: rgb(243 230 207 / 0.1);
    color: #f3e6cf;
  }

  .proto--fija .ficha__categoria {
    color: var(--oro);
  }

  .proto--fija .ficha__titulo {
    margin-bottom: 0.1rem;
    color: #fff4df;
  }

  .proto--fija .ficha__lugar {
    margin: 0 0 0.8rem;
    font-family: 'Libre Baskerville', Georgia, serif;
    font-style: italic;
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--oro) 80%, #fff);
  }

  .proto--fija .ficha__audio {
    color: #f3e6cf;
    background: rgb(243 230 207 / 0.08);
  }

  .proto--fija .ficha__audio:hover,
  .proto--fija .ficha__audio:focus-visible {
    background: rgb(243 230 207 / 0.15);
  }

  .proto--fija .ficha__audio-texto {
    color: rgb(243 230 207 / 0.7);
  }

  .proto--fija .ficha__barra {
    background: rgb(243 230 207 / 0.15);
  }

  .proto--fija .ficha__play,
  .proto--fija .ficha__barra span {
    background: var(--oro);
  }

  .proto--fija .ficha__play svg {
    fill: #2e070b;
  }

  .proto--fija .ficha__dato {
    background: rgb(0 0 0 / 0.22);
    border: 1px solid rgb(254 173 21 / 0.3);
  }

  .proto--fija .ficha__dato strong {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-style: italic;
    color: var(--oro);
  }

  .ficha__nav {
    margin-top: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .ficha__paso {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgb(254 173 21 / 0.55);
    background: transparent;
    transition: background 0.2s;
  }

  .ficha__paso:hover,
  .ficha__paso:focus-visible {
    background: rgb(254 173 21 / 0.18);
  }

  .ficha__paso svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ficha__contador {
    min-width: 3.5rem;
    text-align: center;
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }
</style>

<script>
  import '../../scripts/prototipo/motor-fijo';
</script>
