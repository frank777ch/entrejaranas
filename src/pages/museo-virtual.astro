---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import isotipo from '../assets/marca/isotipo.png';
import { sitio } from '../data/sitio';

const { nombre, descripcion, embedUrl } = sitio.museoVirtual;
---

<Base titulo="Museo Virtual" descripcion={descripcion}>
  <section class="seccion">
    <div class="contenedor">
      <p class="antetitulo">Museo virtual</p>
      <h1 class="titulo-seccion">{nombre}</h1>
      <p class="desc">{descripcion}</p>

      <div class="marco">
        {
          embedUrl ? (
            <iframe src={embedUrl} title={nombre} allow="fullscreen; xr-spatial-tracking; gyroscope; accelerometer" allowfullscreen />
          ) : (
            <div class="pronto">
              <Image src={isotipo} alt="" width={220} />
              <p class="pronto__titulo">Estamos preparando las salas</p>
              <p>Muy pronto podrás recorrer el museo desde aquí.</p>
              <a href="/" class="boton boton--oro">Volver al inicio</a>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .desc {
    max-width: 60ch;
    margin-top: 1.25rem;
    font-size: 1.1rem;
  }
  .marco {
    margin-top: 2.5rem;
    aspect-ratio: 16 / 9;
    border-radius: var(--radio);
    border: 8px solid var(--vino);
    box-shadow: 0 14px 0 var(--cafe);
    overflow: hidden;
    background: var(--cafe);
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .pronto {
    height: 100%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
    color: var(--crema);
  }
  .pronto img {
    width: 110px;
    height: auto;
    margin-bottom: 0.5rem;
  }
  .pronto__titulo {
    font-family: var(--f-titulo);
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--oro);
  }
  .pronto .boton {
    margin-top: 1rem;
  }
  @media (max-width: 640px) {
    .marco {
      aspect-ratio: 3 / 4;
    }
  }
</style>
